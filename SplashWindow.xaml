<Window x:Class="DaBoyzApp.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Width="700"
        Height="400">

    <Grid>

        <Border Background="#080808"
                CornerRadius="12"
                BorderBrush="#292929"
                BorderThickness="1"
                ClipToBounds="True">

            <Grid>

                <Border Background="#080808"/>

                <Image Source="/Assets/SplashBackground.png"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Opacity="0.40"/>

                <Border Background="#30000000"/>

                <Ellipse Width="420"
                         Height="420"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Opacity="0.08">

                    <Ellipse.Fill>

                        <RadialGradientBrush>

                            <GradientStop Color="#E00000"
                                          Offset="0"/>

                            <GradientStop Color="#E00000"
                                          Offset="0.35"/>

                            <GradientStop Color="#00000000"
                                          Offset="1"/>

                        </RadialGradientBrush>

                    </Ellipse.Fill>

                </Ellipse>

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <TextBlock x:Name="LogoText"
                               Text="DA BOYZ"
                               Foreground="White"
                               FontSize="52"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Opacity="0"
                               RenderTransformOrigin="0.5,0.5">

                        <TextBlock.RenderTransform>

                            <TranslateTransform Y="15"/>

                        </TextBlock.RenderTransform>

                    </TextBlock>

                    <TextBlock x:Name="SubtitleText"
                               Text="COMMUNITY HUB"
                               Foreground="#FF1A1A"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"
                               Opacity="0"/>

                    <Border Width="280"
                            Height="1"
                            Background="#606060"
                            Margin="0,25,0,20"/>

                    <TextBlock x:Name="StatusText"
                               Text="INITIALIZING..."
                               Foreground="#D0D0D0"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Opacity="0"/>

                    <Border Width="280"
                            Height="4"
                            Background="#80161616"
                            CornerRadius="2"
                            Margin="0,10,0,0">

                        <Border x:Name="LoadingBar"
                                Width="0"
                                Height="4"
                                HorizontalAlignment="Left"
                                Background="#E00000"
                                CornerRadius="2"/>

                    </Border>

                </StackPanel>

                <TextBlock Text="Created by: KaroDevGroup"
                           Foreground="#A0A0A0"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,40"/>

                <TextBlock x:Name="VersionText"
                           Text="v0.0.0 BETA"
                           Foreground="#777777"
                           FontSize="9"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,18"/>

            </Grid>

        </Border>

    </Grid>

</Window>