<Application x:Class="DaBoyzApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DaBoyzApp">

    <Application.Resources>

        <Color x:Key="DaBoyzRedColor">#E00000</Color>
        <Color x:Key="DaBoyzRedBrightColor">#FF1A1A</Color>

        <Color x:Key="DaBoyzBackgroundColor">#080808</Color>
        <Color x:Key="DaBoyzSidebarColor">#151515</Color>

        <Color x:Key="DaBoyzPanelColor">#161616</Color>
        <Color x:Key="DaBoyzPanelLightColor">#1E1E1E</Color>

        <Color x:Key="DaBoyzBorderColor">#292929</Color>

        <Color x:Key="DaBoyzTextColor">#FFFFFF</Color>
        <Color x:Key="DaBoyzTextSecondaryColor">#B0B0B0</Color>
        <Color x:Key="DaBoyzTextMutedColor">#666666</Color>

        <SolidColorBrush x:Key="DaBoyzRed"
                         Color="{StaticResource DaBoyzRedColor}"/>

        <SolidColorBrush x:Key="DaBoyzRedBright"
                         Color="{StaticResource DaBoyzRedBrightColor}"/>

        <SolidColorBrush x:Key="DaBoyzBackground"
                         Color="{StaticResource DaBoyzBackgroundColor}"/>

        <SolidColorBrush x:Key="DaBoyzSidebar"
                         Color="{StaticResource DaBoyzSidebarColor}"/>

        <SolidColorBrush x:Key="DaBoyzPanel"
                         Color="{StaticResource DaBoyzPanelColor}"/>

        <SolidColorBrush x:Key="DaBoyzPanelLight"
                         Color="{StaticResource DaBoyzPanelLightColor}"/>

        <SolidColorBrush x:Key="DaBoyzBorder"
                         Color="{StaticResource DaBoyzBorderColor}"/>

        <SolidColorBrush x:Key="DaBoyzText"
                         Color="{StaticResource DaBoyzTextColor}"/>

        <SolidColorBrush x:Key="DaBoyzTextSecondary"
                         Color="{StaticResource DaBoyzTextSecondaryColor}"/>

        <SolidColorBrush x:Key="DaBoyzTextMuted"
                         Color="{StaticResource DaBoyzTextMutedColor}"/>

        <DropShadowEffect x:Key="DaBoyzCardShadow"
                          Color="#000000"
                          BlurRadius="18"
                          ShadowDepth="5"
                          Opacity="0.55"/>

        <Style x:Key="DashboardCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource DaBoyzPanel}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource DaBoyzBorder}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="24"/>

            <Setter Property="Effect"
                    Value="{StaticResource DaBoyzCardShadow}"/>

        </Style>

        <Style x:Key="DaBoyzCardStyle"
                TargetType="Border">

                <!-- NORMAL CARD -->

                <Setter Property="Background"
                        Value="{StaticResource DaBoyzPanel}"/>

                <Setter Property="BorderBrush"
                        Value="{StaticResource DaBoyzBorder}"/>

                <Setter Property="BorderThickness"
                        Value="1"/>

                <Setter Property="CornerRadius"
                        Value="12"/>

                <Setter Property="Padding"
                        Value="24"/>

                <!-- Shadow -->

                <Setter Property="Effect">

                        <Setter.Value>

                                <DropShadowEffect Color="#000000"
                                                BlurRadius="18"
                                                ShadowDepth="6"
                                                Opacity="0.70"/>

                        </Setter.Value>

                </Setter>

                <!-- Position -->

                <Setter Property="RenderTransform">

                        <Setter.Value>

                                <TranslateTransform X="0"
                                                    Y="0"/>

                        </Setter.Value>

                </Setter>

                <Setter Property="RenderTransformOrigin"
                        Value="0.5,0.5"/>

                <Style.Triggers>

                        <Trigger Property="IsMouseOver"
                                Value="True">

                                <!-- Brighter surface -->

                                <Setter Property="Background"
                                        Value="#202020"/>

                                <!-- Red border -->

                                <Setter Property="BorderBrush"
                                        Value="{StaticResource DaBoyzRed}"/>

                                <!-- Red ambient glow -->

                                <Setter Property="Effect">

                                        <Setter.Value>

                                                <DropShadowEffect Color="#E00000"
                                                                BlurRadius="25"
                                                                ShadowDepth="6"
                                                                Opacity="0.55"/>

                                        </Setter.Value>

                                </Setter>

                                <!-- Lift card -->

                                <Setter Property="RenderTransform">

                                        <Setter.Value>

                                                <TranslateTransform X="0"
                                                                    Y="-6"/>

                                        </Setter.Value>

                                </Setter>

                        </Trigger>

                </Style.Triggers>

        </Style>

        <Style x:Key="DashboardButtonStyle"
                        TargetType="Button">

                <Setter Property="Background"
                        Value="#161616"/>

                <Setter Property="Foreground"
                        Value="White"/>

                <Setter Property="BorderThickness"
                        Value="0"/>

                <Setter Property="Cursor"
                        Value="Hand"/>

                <Setter Property="Padding"
                        Value="0"/>

                <Setter Property="Template">

                        <Setter.Value>

                                <ControlTemplate TargetType="Button">

                                        <Border x:Name="Card"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="#292929"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="24">

                                                <ContentPresenter/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                                <Trigger Property="IsMouseOver"
                                                        Value="True">

                                                        <Setter TargetName="Card"
                                                                Property="Background"
                                                                Value="#1E1E1E"/>

                                                        <Setter TargetName="Card"
                                                                Property="BorderBrush"
                                                                Value="#E00000"/>

                                                </Trigger>

                                                <Trigger Property="IsPressed"
                                                        Value="True">

                                                        <Setter TargetName="Card"
                                                                Property="Background"
                                                                Value="#252525"/>

                                                </Trigger>

                                        </ControlTemplate.Triggers>

                                </ControlTemplate>

                        </Setter.Value>

                </Setter>

        </Style>

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource DaBoyzText}"/>

            <Setter Property="FontSize"
                    Value="20"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

        </Style>

        <Style x:Key="AdminDashboardButtonStyle"
                TargetType="Button">

                <Setter Property="Background"
                        Value="#161616"/>

                <Setter Property="Foreground"
                        Value="{StaticResource DaBoyzText}"/>
                
                <Setter Property="BorderThickness"
                        Value="0"/>
                
                <Setter Property="Cursor"
                        Value="Hand"/>

                <Setter Property="Padding"
                        Value="0"/>

                <Setter Property="Template">

                        <Setter.Value>

                                <ControlTemplate TargetType="Button">

                                        <Border x:Name="Card"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{StaticResource DaBoyzBorder}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="24">

                                            <ContentPresenter/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                                <Trigger Property="IsMouseOver"
                                                        Value="True">
                                                
                                                        <Setter TargetName="Card"
                                                                Property="Background"
                                                                Value="#202020"/>

                                                        <Setter TargetName="Card"
                                                                Property="BorderBrush"
                                                                Value="{StaticResource DaBoyzRed}"/>

                                                        <Setter TargetName="Card"
                                                                Property="RenderTransform">

                                                            <Setter.Value>
                                                                <TranslateTransform X="0" Y="-6"/>
                                                            </Setter.Value>
                                                        
                                                        </Setter>
                                                
                                                </Trigger>

                                                <Trigger Property="IsPressed"
                                                        Value="True">

                                                    <Setter TargetName="Card"
                                                        Property="Background"
                                                        Value="#252525"/>
                                                
                                                </Trigger>
                                        
                                        </ControlTemplate.Triggers>

                                </ControlTemplate>

                        </Setter.Value>

                </Setter>

        </Style>

        <Style x:Key="AccentButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="{StaticResource DaBoyzRed}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="18,10"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

        <!-- WHITE TEXT CARET -->

        <Style TargetType="TextBox">
        
            <Setter Property="CaretBrush"
                        Value="White"/>
        </Style>

        <Style TargetType="PasswordBox">
                
            <Setter Property="CaretBrush"
                        Value="White"/>
        </Style>

        <Style x:Key="DestinyCategoryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#161616"/>
                <Setter Property="Foreground" Value="{StaticResource DaBoyzText}"/>
                <Setter Property="BorderBrush" Value="#292929"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="18,10"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>

                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">

                                            <ContentPresenter
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                                        </Border>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

    </Application.Resources>

</Application>
