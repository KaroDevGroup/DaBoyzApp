<Page x:Class="DaBoyzApp.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>

        <!-- ========================================================= -->
        <!-- DASHBOARD CARD HOVER STYLE                                -->
        <!-- ========================================================= -->

        <Style x:Key="DashboardButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#161616"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#292929"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="24">

                            <ContentPresenter/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Card"
                                        Property="Background"
                                        Value="#1E1E1E"/>

                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="#E00000"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Card"
                                        Property="Background"
                                        Value="#252525"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Page.Resources>


    <!-- ============================================================= -->
    <!-- ROOT                                                          -->
    <!-- ============================================================= -->

    <Grid Background="Transparent">

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="45,40,45,40">


                <!-- ================================================= -->
                <!-- HEADER                                            -->
                <!-- ================================================= -->

                <StackPanel>

                    <TextBlock Text="WELCOME TO"
                               Foreground="{StaticResource DaBoyzTextSecondary}"
                               FontSize="14"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="DA BOYZ"
                               Foreground="{StaticResource DaBoyzText}"
                               FontSize="42"
                               FontWeight="Bold"
                               Margin="0,2,0,0"/>

                    <TextBlock Text="Your community hub for games, music, updates, and more."
                               Foreground="{StaticResource DaBoyzTextSecondary}"
                               FontSize="14"
                               Margin="0,5,0,0"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- ACCENT                                            -->
                <!-- ================================================= -->

                <Border Height="2"
                        Width="80"
                        Background="{StaticResource DaBoyzRed}"
                        HorizontalAlignment="Left"
                        Margin="0,18,0,30"/>


                <!-- ================================================= -->
                <!-- QUICK ACCESS                                      -->
                <!-- ================================================= -->

                <TextBlock Text="QUICK ACCESS"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,15"/>


                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- GAMING -->

                    <Button Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="0,0,8,8"
                            Click="GamingCard_Click">

                        <StackPanel>

                            <TextBlock Text="◆"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="26"
                                       FontWeight="Bold"/>

                            <TextBlock Text="GAMING DATABASE"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,10,0,3"/>

                            <TextBlock Text="Browse games, guides, builds, and gaming information."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="EXPLORE  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>


                    <!-- MUSIC -->

                    <Button Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="8,0,0,8"
                            Click="MusicCard_Click">

                        <StackPanel>

                            <TextBlock Text="♫"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="30"
                                       FontWeight="Bold"/>

                            <TextBlock Text="MUSIC"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,10,0,3"/>

                            <TextBlock Text="Explore music, beats, production, and everything audio."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="BROWSE  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>


                    <!-- PATCH NOTES -->

                    <Button Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="0,8,8,0"
                            Click="PatchNotesCard_Click">

                        <StackPanel>

                            <TextBlock Text="▤"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="30"
                                       FontWeight="Bold"/>

                            <TextBlock Text="PATCH NOTES"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,10,0,3"/>

                            <TextBlock Text="See what's new, what's changed, and what's coming next."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="VIEW UPDATES  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>


                    <!-- ADMIN -->

                    <Button Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="8,8,0,0"
                            Click="AdminCard_Click">

                        <StackPanel>

                            <TextBlock Text="⚙"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="30"/>

                            <TextBlock Text="ADMIN PORTAL"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,10,0,3"/>

                            <TextBlock Text="Manage application data and community content."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="OPEN PORTAL  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>

                </Grid>


                <!-- ================================================= -->
                <!-- COMMUNITY OVERVIEW                                -->
                <!-- ================================================= -->

                <TextBlock Text="COMMUNITY OVERVIEW"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,35,0,15"/>


                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- MEMBERS -->

                    <Border Grid.Column="0"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="0,0,5,0">

                        <StackPanel>

                            <TextBlock Text="MEMBERS"
                                       Foreground="{StaticResource DaBoyzTextMuted}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="113"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- ONLINE -->

                    <Border Grid.Column="1"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="5,0">

                        <StackPanel>

                            <TextBlock Text="ONLINE"
                                       Foreground="{StaticResource DaBoyzTextMuted}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="—"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- GAMES -->

                    <Border Grid.Column="2"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="5,0">

                        <StackPanel>

                            <TextBlock Text="GAMES"
                                       Foreground="{StaticResource DaBoyzTextMuted}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="8"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- MUSIC -->

                    <Border Grid.Column="3"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="5,0,0,0">

                        <StackPanel>

                            <TextBlock Text="TRACKS"
                                       Foreground="{StaticResource DaBoyzTextMuted}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="0"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- LATEST UPDATES                                    -->
                <!-- ================================================= -->

                <TextBlock Text="LATEST UPDATES"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,35,0,15"/>


                <Border Style="{StaticResource DashboardCardStyle}">

                    <StackPanel>

                        <TextBlock Text="DA BOYZ APP"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Welcome to the Da Boyz Community Hub."
                                   Foreground="{StaticResource DaBoyzText}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,2"/>

                        <TextBlock Text="Version 1.1.5 BETA • Application foundation is now being built."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- SERVER STATUS                                     -->
                <!-- ================================================= -->

                <TextBlock Text="SERVER STATUS"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,35,0,15"/>


                <Border Style="{StaticResource DashboardCardStyle}">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock Text="DA BOYZ DISCORD"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Community server"
                                       Foreground="{StaticResource DaBoyzTextMuted}"
                                       FontSize="12"
                                       Margin="0,3,0,0"/>

                        </StackPanel>


                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="#3CCB5F"
                                     Margin="0,0,8,0"/>

                            <TextBlock Text="ONLINE"
                                       Foreground="#3CCB5F"
                                       FontSize="12"
                                       FontWeight="Bold"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- FOOTER                                            -->
                <!-- ================================================= -->

                <StackPanel HorizontalAlignment="Center"
                            Margin="0,35,0,0">

                    <TextBlock Text="DA BOYZ • COMMUNITY HUB"
                               Foreground="{StaticResource DaBoyzTextMuted}"
                               FontSize="11"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Created by: KaroDevGroup"
                               Foreground="#666666"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>