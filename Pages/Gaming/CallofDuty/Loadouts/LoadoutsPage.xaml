<Page x:Class="DaBoyzApp.Pages.LoadoutsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      Background="Transparent">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="10,5,10,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="CALL OF DUTY  /  LOADOUTS"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#B0B0B0"/>

                <TextBlock Text="LOADOUTS"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,2,0,0"/>

                <TextBlock Text="Explore powerful loadouts for Warzone/MW."
                           FontSize="13"
                           Foreground="#B0B0B0"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Content="BACK TO COD"
                    Width="180"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="#161616"
                    Foreground="#B0B0B0"
                    BorderBrush="#292929"
                    BorderThickness="1"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Padding="18,10"
                    Cursor="Hand"
                    Click="BackButton_Click"/>

        </Grid>

        <Border Grid.Row="1"
                Background="#101010"
                BorderBrush="#292929"
                BorderThickness="1">

            <wv2:WebView2 x:Name="LoadoutsBrowser"/>

        </Border>

    </Grid>

</Page>