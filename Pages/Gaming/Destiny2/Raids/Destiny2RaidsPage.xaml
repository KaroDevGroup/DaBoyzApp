<Page x:Class="DaBoyzApp.Pages.Destiny2RaidsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="DESTINY 2"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#B0B0B0"/>

                <TextBlock Text="RAIDS"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,2,0,0"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Content="BACK TO DESTINY 2"
                    Width="180"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="#161616"
                    Foreground="#B0B0B0"
                    BorderBrush="#292929"
                    BorderThickness="1"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Padding="18,10"
                    Cursor="Hand"
                    Click="BackButton_Click"/>

        </Grid>


        <!-- DESCRIPTION -->
        <TextBlock Grid.Row="1"
                   Text="Explore raid mechanics, encounters, recommended loadouts, loot, and encounter videos."
                   FontSize="13"
                   Foreground="#B0B0B0"
                   Margin="0,15,0,25"/>


        <!-- RAID CARDS -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <UniformGrid Columns="2">


                <!-- ====================================================== -->
                <!-- LAST WISH -->
                <!-- ====================================================== -->

                <Button Margin="0,0,12,12"
                        Height="165"
                        Background="#161616"
                        BorderBrush="#292929"
                        Style="{StaticResource AdminDashboardButtonStyle}"
                        BorderThickness="1"
                        Click="LastWish_Click">

                    <Grid Margin="20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="/Assets/Icons/raidicon.png"
                               Width="65"
                               Height="65"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0">

                            <TextBlock Text="LAST WISH"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Dreaming City"
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       Margin="0,5,0,12"/>

                            <TextBlock Text="VIEW RAID  →"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF1A1A"/>

                        </StackPanel>

                    </Grid>

                </Button>


                <!-- ====================================================== -->
                <!-- GARDEN OF SALVATION -->
                <!-- ====================================================== -->

                <Button Margin="12,0,0,12"
                        Height="165"
                        Background="#161616"
                        BorderBrush="#292929"
                        Style="{StaticResource AdminDashboardButtonStyle}"
                        BorderThickness="1"
                        Click="GardenOfSalvation_Click">

                    <Grid Margin="20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="/Assets/Icons/raidicon.png"
                               Width="65"
                               Height="65"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0">

                            <TextBlock Text="GARDEN OF SALVATION"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Black Garden"
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       Margin="0,5,0,12"/>

                            <TextBlock Text="VIEW RAID  →"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF1A1A"/>

                        </StackPanel>

                    </Grid>

                </Button>


                <!-- ====================================================== -->
                <!-- DEEP STONE CRYPT -->
                <!-- ====================================================== -->

                <Button Margin="0,12,12,12"
                        Height="165"
                        Background="#161616"
                        BorderBrush="#292929"
                        Style="{StaticResource AdminDashboardButtonStyle}"
                        BorderThickness="1"
                        Click="DeepStoneCrypt_Click">

                    <Grid Margin="20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="/Assets/Icons/raidicon.png"
                               Width="65"
                               Height="65"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0">

                            <TextBlock Text="DEEP STONE CRYPT"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Europa"
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       Margin="0,5,0,12"/>

                            <TextBlock Text="VIEW RAID  →"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF1A1A"/>

                        </StackPanel>

                    </Grid>

                </Button>


                <!-- ====================================================== -->
                <!-- VAULT OF GLASS -->
                <!-- ====================================================== -->

                <Button Margin="12,12,0,12"
                        Height="165"
                        Background="#161616"
                        BorderBrush="#292929"
                        Style="{StaticResource AdminDashboardButtonStyle}"
                        BorderThickness="1"
                        Click="VaultOfGlass_Click">

                    <Grid Margin="20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="/Assets/Icons/raidicon.png"
                               Width="65"
                               Height="65"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0">

                            <TextBlock Text="NOT COMPLETE"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Venus"
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       Margin="0,5,0,12"/>

                            <TextBlock Text="VIEW RAID  →"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF1A1A"/>

                        </StackPanel>

                    </Grid>

                </Button>


                <!-- ====================================================== -->
                <!-- VOW OF THE DISCIPLE -->
                <!-- ====================================================== -->

                <Button Margin="0,12,12,12"
                        Height="165"
                        Background="#161616"
                        BorderBrush="#292929"
                        Style="{StaticResource AdminDashboardButtonStyle}"
                        BorderThickness="1"
                        Click="VowOfTheDisciple_Click">

                    <Grid Margin="20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="/Assets/Icons/raidicon.png"
                               Width="65"
                               Height="65"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0">

                            <TextBlock Text="NOT COMPLETE"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Pyramid Ship"
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       Margin="0,5,0,12"/>

                            <TextBlock Text="VIEW RAID  →"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF1A1A"/>

                        </StackPanel>

                    </Grid>

                </Button>


                <!-- ====================================================== -->
                <!-- KING'S FALL -->
                <!-- ====================================================== -->

                <Button Margin="12,12,0,12"
                        Height="165"
                        Background="#161616"
                        BorderBrush="#292929"
                        Style="{StaticResource AdminDashboardButtonStyle}"
                        BorderThickness="1"
                        Click="KingsFall_Click">

                    <Grid Margin="20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="/Assets/Icons/raidicon.png"
                               Width="65"
                               Height="65"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0">

                            <TextBlock Text="KING'S FALL"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Oryx's Dreadnaught"
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       Margin="0,5,0,12"/>

                            <TextBlock Text="VIEW RAID  →"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF1A1A"/>

                        </StackPanel>

                    </Grid>

                </Button>


                <!-- ====================================================== -->
                <!-- ROOT OF NIGHTMARES -->
                <!-- ====================================================== -->

                <Button Margin="0,12,12,12"
                        Height="165"
                        Background="#161616"
                        BorderBrush="#292929"
                        Style="{StaticResource AdminDashboardButtonStyle}"
                        BorderThickness="1"
                        Click="RootOfNightmares_Click">

                    <Grid Margin="20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="/Assets/Icons/raidicon.png"
                               Width="65"
                               Height="65"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0">

                            <TextBlock Text="NOT COMPLETE"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Nezarec"
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       Margin="0,5,0,12"/>

                            <TextBlock Text="VIEW RAID  →"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF1A1A"/>

                        </StackPanel>

                    </Grid>

                </Button>


                <!-- ====================================================== -->
                <!-- CROTA'S END -->
                <!-- ====================================================== -->

                <Button Margin="12,12,0,12"
                        Height="165"
                        Background="#161616"
                        BorderBrush="#292929"
                        Style="{StaticResource AdminDashboardButtonStyle}"
                        BorderThickness="1"
                        Click="CrotasEnd_Click">

                    <Grid Margin="20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="/Assets/Icons/raidicon.png"
                               Width="65"
                               Height="65"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0">

                            <TextBlock Text="NOT COMPLETE"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Crota, Son of Oryx"
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       Margin="0,5,0,12"/>

                            <TextBlock Text="VIEW RAID  →"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF1A1A"/>

                        </StackPanel>

                    </Grid>

                </Button>


                <!-- ====================================================== -->
                <!-- SALVATION'S EDGE -->
                <!-- ====================================================== -->

                <Button Margin="0,12,12,12"
                        Height="165"
                        Background="#161616"
                        BorderBrush="#292929"
                        Style="{StaticResource AdminDashboardButtonStyle}"
                        BorderThickness="1"
                        Click="SalvationsEdge_Click">

                    <Grid Margin="20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="/Assets/Icons/raidicon.png"
                               Width="65"
                               Height="65"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0">

                            <TextBlock Text="NOT COMPLETE"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="The Pale Heart"
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       Margin="0,5,0,12"/>

                            <TextBlock Text="VIEW RAID  →"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF1A1A"/>

                        </StackPanel>

                    </Grid>

                </Button>


                <!-- ====================================================== -->
                <!-- THE DESERT PERPETUAL -->
                <!-- ====================================================== -->

                <Button Margin="12,12,0,12"
                        Height="165"
                        Background="#161616"
                        BorderBrush="#292929"
                        Style="{StaticResource AdminDashboardButtonStyle}"
                        BorderThickness="1"
                        Click="DesertPerpetual_Click">

                    <Grid Margin="20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0"
                               Source="/Assets/Icons/raidicon.png"
                               Width="65"
                               Height="65"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0">

                            <TextBlock Text="NOT COMPLETE"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="The Desert"
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       Margin="0,5,0,12"/>

                            <TextBlock Text="VIEW RAID  →"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF1A1A"/>

                        </StackPanel>

                    </Grid>

                </Button>


            </UniformGrid>

        </ScrollViewer>

    </Grid>

</Page>