<Page x:Class="DaBoyzApp.Pages.TaniksRebornPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:DaBoyzApp.Controls"
      Background="Transparent">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="DEEP STONE CRYPT  /  ENCOUNTER 03"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#B0B0B0"/>

                <TextBlock Text="TANIKS, REBORN"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,2,0,0"/>

                <TextBlock Text="THE DESCENT"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FF1A1A"
                           Margin="0,4,0,0"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Content="BACK TO DEEP STONE"
                    Width="180"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="#161616"
                    Foreground="#B0B0B0"
                    BorderBrush="#292929"
                    BorderThickness="1"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Padding="18,10"
                    Cursor="Hand"
                    Click="BackButton_Click"/>

        </Grid>


        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,25,0,0"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>


                <!-- OBJECTIVE -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="OBJECTIVE"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>

                        <TextBlock Text="DISARM THE MORNING STAR"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="Prevent the Morning Star from destroying Europa by collecting Nuclear Cores, carrying them to the correct deposit bins, and coordinating all three Deep Stone Crypt augments."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <!-- ENCOUNTER FLOW -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="ENCOUNTER FLOW"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>


                        <!-- STEP 1 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="01  —  ASSIGN THE AUGMENTS"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Collect Operator, Scanner, and Suppressor from the Vandals around the arena. Assign backups for each role and establish who will carry Nuclear Cores."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>


                        <!-- STEP 2 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="02  —  PREPARE THE CORE WAVE"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Taniks activates three Nuclear Core dispensers. The Operator identifies one active dispenser and shoots its panel to prevent a third core from spawning."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>


                        <!-- STEP 3 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="03  —  SCANNER CALLS THE BINS"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="The Scanner looks at the four deposit bins and identifies the two valid destinations. Call the full position clearly so each carrier knows exactly where to go."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>


                        <!-- STEP 4 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="04  —  SUPPRESS TANIKS"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="The Suppressor must stand underneath each active security drone and shoot Taniks from that position. Successfully hitting all three drones stuns Taniks and unlocks the deposit bins."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>


                        <!-- STEP 5 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="05  —  CARRY THE NUCLEAR CORES"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Pick up the spawned Nuclear Cores and carry them to the Scanner's called bins. Carrying a core applies Radiation, so pass or deposit the core before Radiation reaches a dangerous level."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>


                        <!-- STEP 6 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="06  —  BANK DISABLED AUGMENTS"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="After a successful deposit sequence, one augment may become disabled. The affected player must bank that augment at a terminal so another Guardian can take over the role."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>


                        <!-- STEP 7 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="07  —  REPEAT FOR SIX WAVES"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Repeat the Operator, Scanner, Suppressor, and Nuclear Core mechanics across six successful waves. Rotate the augments according to the team's assignment plan."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>


                        <!-- STEP 8 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="08  —  ESCAPE"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="After the final successful wave, the center hatch opens. Move through the hatch and escape the collapsing Morning Star before the encounter area becomes inaccessible."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </StackPanel>

                </Border>


                <!-- ROLES -->
                <TextBlock Text="ROLES"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF1A1A"
                           Margin="0,0,0,15"/>

                <UniformGrid Columns="3"
                             Margin="0,0,0,20">


                    <!-- OPERATOR -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="0,0,7,0">

                        <StackPanel>

                            <TextBlock Text="OPERATOR"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Shoot the panel beside one active Nuclear Core dispenser to prevent a third core from spawning. Rotate this role as required by the challenge."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="19"
                                       Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- SCANNER -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="7,0,7,0">

                        <StackPanel>

                            <TextBlock Text="SCANNER"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Identify the two valid Nuclear Core deposit bins and clearly call their positions to the carriers."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="19"
                                       Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- SUPPRESSOR -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="7,0,0,0">

                        <StackPanel>

                            <TextBlock Text="SUPPRESSOR"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Stand underneath all three active security drones and shoot Taniks from each position to stun him and unlock the deposit bins."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="19"
                                       Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>


                <!-- IMPORTANT MECHANICS -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="IMPORTANT MECHANICS"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>


                        <TextBlock Text="NUCLEAR CORES"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Three dispensers begin charging, but the Operator disables one so only two Nuclear Cores normally spawn. Every spawned core must be picked up and delivered to a valid bin. A core left unattended for too long causes a wipe."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,5,0,0"/>


                        <TextBlock Text="RADIATION"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Carrying a Nuclear Core builds Radiation. At ten stacks, the carrier dies. Pass or deposit the core before the Radiation becomes lethal."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,5,0,0"/>


                        <TextBlock Text="SUPPRESSOR DRONES"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="The Suppressor must stand beneath each of the three drones and damage Taniks from those positions. The third successful suppression stuns Taniks and unlocks the deposit bins."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,5,0,0"/>


                        <TextBlock Text="AUGMENT DEACTIVATION"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="A successful deposit sequence can deactivate one of the three augments. Bank the disabled augment at a terminal and assign a new Guardian to that role. The previous holder cannot immediately reclaim it."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,5,0,0"/>


                        <TextBlock Text="SIX WAVES"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="The encounter consists of six successful Nuclear Core waves. The team must maintain its augment rotation throughout all six waves before the escape route becomes available."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>


                <!-- CHALLENGE -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="CHALLENGE"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>

                        <TextBlock Text="OF ALL TRADES"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="Across all six Nuclear Core waves, every Guardian must successfully perform the Scanner, Operator, and Suppressor roles at least once. Rotate all three augments between waves instead of leaving the same players on the same roles."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <!-- COMMON MISTAKES -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="COMMON MISTAKES"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>

                        <TextBlock Text="•  Operator fails to disable an active dispenser."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="•  Scanner gives an incomplete or confusing bin callout."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="•  Suppressor misses one of the three drone positions."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="•  A Nuclear Core is left unattended."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="•  A carrier reaches ten Radiation stacks."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="•  A disabled augment is not banked before the next role rotation."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="•  The team forgets to rotate roles for Of All Trades."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <!-- VIDEO GUIDE -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="VIDEO GUIDE"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"
                                   Margin="0,0,0,15"/>

                        <controls:YouTubePlayer VideoId="htPnj2oPzCM"
                                                Height="400"/>

                    </StackPanel>

                </Border>


            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>