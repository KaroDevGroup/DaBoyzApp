<Page x:Class="DaBoyzApp.Pages.Atraks1Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:DaBoyzApp.Controls"
      Background="Transparent">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>



        <!-- HEADER -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="DEEP STONE CRYPT  /  ENCOUNTER 02"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#B0B0B0"/>

                <TextBlock Text="ATRAKS-1"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,2,0,0"/>

                <TextBlock Text="FALLEN EXO"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FF1A1A"
                           Margin="0,4,0,0"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Content="BACK TO DEEP STONE"
                    Width="180"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="#161616"
                    Foreground="#B0B0B0"
                    BorderBrush="#292929"
                    BorderThickness="1"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Padding="18,10"
                    Cursor="Hand"
                    Click="BackButton_Click"/>

        </Grid>



        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,25,0,0"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>



                <!-- OBJECTIVE -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="OBJECTIVE"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>

                        <TextBlock Text="DEFEAT ATRAKS-1"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="Track Atraks-1 through the Europa facility and the orbital station, identify the real Atraks copies, and send the replication debuffs into space before they overwhelm the fireteam."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>



                <!-- ENCOUNTER FLOW -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="ENCOUNTER FLOW"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>



                        <!-- STEP 1 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="01  —  START THE ENCOUNTER"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Begin the encounter and prepare the fireteam for Atraks-1's copies. Keep the Europa and space station teams organized and establish who will handle each augment."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>



                        <!-- STEP 2 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="02  —  ATRAKS COPIES APPEAR"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Atraks-1 creates multiple copies of itself around the encounter spaces. The Scanner identifies which copy is real during the damage sequence."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>



                        <!-- STEP 3 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="03  —  DAMAGE THE REAL COPY"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="When the damage sequence begins, the Scanner calls out the correct Atraks copy. Damage only the identified copy. Each successful damage cycle creates an Atraks replication that must be dealt with."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>



                        <!-- STEP 4 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="04  —  PICK UP THE REPLICATION"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="The defeated Atraks copy leaves behind a Replication debuff. A designated player must pick it up before it expires or the replication will contribute toward a wipe."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>



                        <!-- STEP 5 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="05  —  USE THE AIRLOCKS"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Players carrying a Replication debuff must take it to an airlock and eject it into space. The Operator opens the correct airlock doors when the team is ready."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>



                        <!-- STEP 6 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="06  —  ROTATE BETWEEN AREAS"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Use the elevators to move between Europa and the orbital station as required. Keep the two sides coordinated so that the Scanner and Operator can provide information and support where needed."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>



                        <!-- STEP 7 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="07  —  FINAL STAND"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Once Atraks-1 reaches critical health, the encounter enters a final stand. Atraks creates multiple copies throughout the station. The Scanner must identify the correct copy while the team rapidly destroys it."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>



                        <!-- STEP 8 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="08  —  COMPLETE THE ENCOUNTER"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Destroy the final Atraks copy during final stand before the remaining replications overwhelm the fireteam. Defeating Atraks-1 completes the encounter."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </StackPanel>

                </Border>



                <!-- ROLES -->
                <TextBlock Text="ROLES"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF1A1A"
                           Margin="0,0,0,15"/>

                <UniformGrid Columns="3"
                             Margin="0,0,0,20">



                    <!-- SCANNER -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="0,0,7,0">

                        <StackPanel>

                            <TextBlock Text="SCANNER"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Identify the correct Atraks copy during damage and final stand. Clear communication is essential because the wrong copy can waste the damage window."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="19"
                                       Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>



                    <!-- OPERATOR -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="7,0,7,0">

                        <StackPanel>

                            <TextBlock Text="OPERATOR"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Control the airlocks and help manage players carrying Replication. Keep the correct doors available when debuffs need to be ejected."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="19"
                                       Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>



                    <!-- REPLICATION TEAM -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="7,0,0,0">

                        <StackPanel>

                            <TextBlock Text="REPLICATION TEAM"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Pick up Atraks replications, carry them to the correct airlock, and coordinate with the Operator so they can be safely ejected."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="19"
                                       Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>



                <!-- IMPORTANT MECHANICS -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="IMPORTANT MECHANICS"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>



                        <TextBlock Text="REPLICATION"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="When an Atraks copy is defeated, it leaves behind a Replication debuff. A player can pick it up and temporarily carry it. If it is not removed before the timer expires, the replication contributes toward the encounter wipe."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,5,0,0"/>



                        <TextBlock Text="AIRLOCKS"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Replication debuffs are removed by taking them through an active airlock and ejecting them into space. Coordinate with the Operator before opening an airlock."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,5,0,0"/>



                        <TextBlock Text="SCANNER"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="The Scanner can identify the correct Atraks copy during the damage sequence. Make sure everyone understands the callout system before damage begins."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,5,0,0"/>



                        <TextBlock Text="FINAL STAND"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Atraks creates multiple copies during final stand. The Scanner must quickly identify the correct copy while the team destroys it before the remaining copies can wipe the fireteam."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>



                <!-- CHALLENGE -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="CHALLENGE"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>

                        <TextBlock Text="COPIES OF COPIES"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="During the encounter, players must successfully send the Replication debuffs into space without allowing a player carrying one to be killed. Keep the debuff carriers coordinated and make sure each replication is safely removed."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>



                <!-- COMMON MISTAKES -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="COMMON MISTAKES"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>



                        <TextBlock Text="•  Scanner gives an unclear or incorrect Atraks callout."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="•  Players damage the wrong Atraks copy."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="•  A Replication debuff is left on the ground."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="•  A debuff carrier reaches the airlock without communicating with the Operator."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="•  The team loses track of Atraks copies during final stand."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>



                <!-- VIDEO GUIDE -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="VIDEO GUIDE"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"
                                   Margin="0,0,0,15"/>

                        <controls:YouTubePlayer VideoId="Q4sXz2Y2d7I"
                                                Height="400"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>