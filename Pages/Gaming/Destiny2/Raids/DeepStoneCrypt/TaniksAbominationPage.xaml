<Page x:Class="DaBoyzApp.Pages.TaniksAbominationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:DaBoyzApp.Controls"
      Background="Transparent">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="DEEP STONE CRYPT  /  ENCOUNTER 04"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#B0B0B0"/>

                <TextBlock Text="TANIKS"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,2,0,0"/>

                <TextBlock Text="THE ABOMINATION"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FF1A1A"
                           Margin="0,4,0,0"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Content="BACK TO DEEP STONE"
                    Width="180"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="#161616"
                    Foreground="#B0B0B0"
                    BorderBrush="#292929"
                    BorderThickness="1"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Padding="18,10"
                    Cursor="Hand"
                    Click="BackButton_Click"/>

        </Grid>


        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,25,0,0"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>


                <!-- OBJECTIVE -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="OBJECTIVE"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>

                        <TextBlock Text="DEFEAT TANIKS"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="Destroy Taniks's thrusters, collect the Nuclear Cores they create, deliver them to the correct bins, and survive the damage phases until Taniks is finally destroyed."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <!-- ENCOUNTER FLOW -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="ENCOUNTER FLOW"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>


                        <!-- STEP 1 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="01  —  FOLLOW TANIKS"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Taniks moves between the three arena zones. Stay with the team and prepare to damage his exposed thrusters when the opportunity appears."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>


                        <!-- STEP 2 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="02  —  DESTROY THE THRUSTERS"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Damage Taniks's exposed thrusters. Destroyed thrusters eject Nuclear Cores that can be picked up by the fireteam."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>


                        <!-- STEP 3 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="03  —  SCANNER CALLS THE BINS"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="The Scanner identifies the valid Nuclear Core deposit bins. Call the zone and side clearly before carriers pick up their cores."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>


                        <!-- STEP 4 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="04  —  FREE DETAINED PLAYERS"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Taniks can trap Guardians inside purple detention fields. The Operator must destroy the detention field before the trapped player is killed."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>


                        <!-- STEP 5 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="05  —  SUPPRESS TANIKS"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="The Suppressor shoots Taniks while standing beneath each of the three active security drones. The third successful suppression opens the Nuclear Core deposit bins."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>


                        <!-- STEP 6 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="06  —  DEPOSIT THE CORES"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Carry the Nuclear Cores to the Scanner's called bins. Radiation increases while carrying a core, so deposit or transfer it before reaching ten stacks."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>


                        <!-- STEP 7 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="07  —  ENTER DAMAGE PHASE"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="After four successful Nuclear Core deposits, Taniks becomes vulnerable. Move into the safe damage area around him and deal as much damage as possible before the phase ends."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>


                        <!-- STEP 8 -->
                        <StackPanel Margin="0,15,0,0">

                            <TextBlock Text="08  —  REPEAT UNTIL FINAL STAND"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Repeat the thruster, Nuclear Core, and deposit mechanics until Taniks reaches final stand. During final stand, follow Taniks and finish him before the team is overwhelmed."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </StackPanel>

                </Border>


                <!-- ROLES -->
                <TextBlock Text="ROLES"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF1A1A"
                           Margin="0,0,0,15"/>

                <UniformGrid Columns="3"
                             Margin="0,0,0,20">


                    <!-- OPERATOR -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="0,0,7,0">

                        <StackPanel>

                            <TextBlock Text="OPERATOR"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Destroy Taniks's detention fields and free trapped Guardians. Maintain line of sight to the fireteam whenever possible."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="19"
                                       Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- SCANNER -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="7,0,7,0">

                        <StackPanel>

                            <TextBlock Text="SCANNER"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Identify the valid Nuclear Core bins and call them clearly to the carriers before they pick up their cores."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="19"
                                       Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- SUPPRESSOR -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="7,0,0,0">

                        <StackPanel>

                            <TextBlock Text="SUPPRESSOR"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Stand underneath each active security drone and shoot Taniks from all three positions. The third hit opens the deposit bins."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="19"
                                       Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>


                <!-- IMPORTANT MECHANICS -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="IMPORTANT MECHANICS"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>


                        <TextBlock Text="NUCLEAR CORES"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Destroyed thrusters produce Nuclear Cores. The cores must be delivered to valid deposit bins. A core left unattended for too long can wipe the encounter."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,5,0,0"/>


                        <TextBlock Text="RADIATION"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Carrying a Nuclear Core applies Radiation stacks. At ten stacks, the carrier dies. Pass the core to another Guardian or deposit it before reaching the lethal threshold."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,5,0,0"/>


                        <TextBlock Text="DETENTION"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Taniks can trap Guardians inside purple detention fields. The Operator must shoot the field from outside to release the trapped player."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,5,0,0"/>


                        <TextBlock Text="SUPPRESSOR DRONES"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="The Suppressor must successfully hit Taniks from beneath all three active drones. The third successful suppression opens the deposit bins and triggers the augment deactivation."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,5,0,0"/>


                        <TextBlock Text="DAMAGE PHASE"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="After four successful core deposits, Taniks becomes vulnerable. Stand inside the safe damage area around the debris field and avoid the lethal Arc energy and moving debris."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>


                <!-- CHALLENGE -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="CHALLENGE"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>

                        <TextBlock Text="THE CORE FOUR"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="Before every damage phase, destroy all four of Taniks's thrusters and deposit all four Nuclear Cores during the same delivery cycle. Do not begin damage with only two cores."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <!-- COMMON MISTAKES -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="COMMON MISTAKES"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>

                        <TextBlock Text="•  Scanner does not clearly call the destination bins."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="•  A Nuclear Core is left sitting on the ground."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="•  A carrier reaches ten Radiation stacks."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="•  Operator misses a detained Guardian."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="•  Suppressor completes the third drone too early."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="•  The team begins damage without completing four deposits."
                                   FontSize="12"
                                   Foreground="#B0B0B0"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <!-- VIDEO GUIDE -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="VIDEO GUIDE"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"
                                   Margin="0,0,0,15"/>

                        <controls:YouTubePlayer VideoId="mVjAC1g94u8"
                                                Height="400"/>

                    </StackPanel>

                </Border>


            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>