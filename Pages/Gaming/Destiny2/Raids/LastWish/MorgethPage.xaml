<Page x:Class="DaBoyzApp.Pages.MorgethPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:DaBoyzApp.Controls"
      Background="Transparent">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="LAST WISH  /  ENCOUNTER 03"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#B0B0B0"/>

                <TextBlock Text="MORGETH"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,2,0,0"/>

                <TextBlock Text="THE SPIREKEEPER"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FF1A1A"
                           Margin="0,4,0,0"/>

            </StackPanel>


            <Button Grid.Column="1"
                    Content="BACK TO LAST WISH"
                    Width="190"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="#161616"
                    Foreground="#B0B0B0"
                    BorderBrush="#292929"
                    BorderThickness="1"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Padding="18,10"
                    Cursor="Hand"
                    Click="BackButton_Click"/>

        </Grid>


        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,25,0,0"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>


                <!-- OBJECTIVE -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="OBJECTIVE"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>

                        <TextBlock Text="Defeat Morgeth, the Spirekeeper."
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="Collect Taken Strength throughout the arena without allowing any Guardian to reach three stacks, cleanse players trapped by Umbral Enervation, and damage Morgeth before his strength reaches 100%."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <!-- ENCOUNTER FLOW -->
                <TextBlock Text="ENCOUNTER FLOW"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF1A1A"
                           Margin="0,10,0,15"/>


                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>


                        <!-- STEP 1 -->
                        <TextBlock Text="1 — START THE ENCOUNTER"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="The player assigned the opening pickup collects the Taken Strength orb floating in front of Morgeth. This wakes Morgeth and begins the encounter."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,20"/>


                        <!-- STEP 2 -->
                        <TextBlock Text="2 — SPLIT LEFT AND RIGHT"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Split the fireteam into two groups of three. Taken enemies begin spawning on both sides. Clear them quickly so the next Taken Strength wave can be collected."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,20"/>


                        <!-- STEP 3 -->
                        <TextBlock Text="3 — COLLECT TAKEN STRENGTH"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Four Taken Strength orbs spawn during the first wave — two on each side. Collect them according to your team's predetermined rotation. Never collect a third stack."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,20"/>


                        <!-- STEP 4 -->
                        <TextBlock Text="4 — CLEANSE UMbral ENERVATION"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Morgeth randomly traps a Guardian carrying Taken Strength with Umbral Enervation. Kill an Eye of Riven, pick up the Taken Essence it drops, move next to the trapped player, and use the relic's grenade ability to cleanse them."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,20"/>


                        <!-- STEP 5 -->
                        <TextBlock Text="5 — REPEAT THE SECOND WAVE"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Another four Taken Strength orbs spawn. Repeat the collection and cleanse process while keeping Morgeth's strength under control."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,20"/>


                        <!-- STEP 6 -->
                        <TextBlock Text="6 — COLLECT THE FINAL ORB"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="After the required Taken enemies have been defeated, the final Taken Strength appears in the center where the encounter began. The designated player collects it to make Morgeth vulnerable."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,20"/>


                        <!-- STEP 7 -->
                        <TextBlock Text="7 — DAMAGE MORGETH"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Once Morgeth becomes vulnerable, group up and damage the glowing weak points on his back. Morgeth continues gaining strength during DPS, so finish him before he reaches 100%."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,20"/>


                        <!-- STEP 8 -->
                        <TextBlock Text="8 — RESET IF NECESSARY"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="If your team cannot kill Morgeth before the wipe, a player carrying Taken Essence can use its Super ability on Morgeth to interrupt the encounter and reset his strength."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,0"/>

                    </StackPanel>

                </Border>


                <!-- ROLES -->
                <TextBlock Text="ROLES"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF1A1A"
                           Margin="0,10,0,15"/>


                <UniformGrid Columns="3"
                             HorizontalAlignment="Stretch"
                             Margin="0,0,0,15">


                    <!-- LEFT TEAM -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="0,0,8,0">

                        <StackPanel>

                            <TextBlock Text="LEFT TEAM"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="3 PLAYERS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF1A1A"
                                       Margin="0,4,0,10"/>

                            <TextBlock Text="Clear enemies, collect the assigned Taken Strength on the left side, and communicate stack counts."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"/>

                        </StackPanel>

                    </Border>


                    <!-- RIGHT TEAM -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="4,0,4,0">

                        <StackPanel>

                            <TextBlock Text="RIGHT TEAM"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="3 PLAYERS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF1A1A"
                                       Margin="0,4,0,10"/>

                            <TextBlock Text="Clear enemies, collect the assigned Taken Strength on the right side, and communicate stack counts."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"/>

                        </StackPanel>

                    </Border>


                    <!-- CLEANSER -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="8,0,0,0">

                        <StackPanel>

                            <TextBlock Text="CLEANSER"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="1 PLAYER"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF1A1A"
                                       Margin="0,4,0,10"/>

                            <TextBlock Text="Prioritize Eye of Riven kills and remain ready to pick up Taken Essence and cleanse a trapped Guardian."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>


                <!-- IMPORTANT MECHANICS -->
                <TextBlock Text="IMPORTANT MECHANICS"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF1A1A"
                           Margin="0,10,0,15"/>


                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>


                        <TextBlock Text="TAKEN STRENGTH"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Taken Strength is collected by walking through the floating Taken Strength orbs. A Guardian can hold a maximum of two stacks. Collecting a third instantly kills the Guardian."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,18"/>


                        <TextBlock Text="10 TOTAL STRENGTH"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="The standard sequence contains one starting orb, four orbs in the first wave, four in the second wave, and one final orb in the center."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,18"/>


                        <TextBlock Text="UMBRAL ENERVATION"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="A player carrying Taken Strength can become trapped and immobilized. The trapped player has a limited amount of time to be cleansed before dying."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,18"/>


                        <TextBlock Text="TAKEN ESSENCE"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Eye of Riven enemies drop Taken Essence. The relic's grenade ability cleanses an affected teammate and transfers their Taken Strength to the cleanser, so the cleanser must have enough capacity."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,18"/>


                        <TextBlock Text="MORGETH'S STRENGTH"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Morgeth continuously builds strength throughout the encounter. At 100%, the team wipes. The closer he gets to full strength, the less time your team has to complete the damage phase."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"/>

                    </StackPanel>

                </Border>


                <!-- CHALLENGE -->
                <TextBlock Text="CHALLENGE"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF1A1A"
                           Margin="0,10,0,15"/>


                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="FOREVER FIGHT"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Do not kill any of the Taken Ogres that spawn during the Morgeth encounter."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="Keep the Ogres alive while completing the Taken Strength mechanics and defeating Morgeth. Be especially careful with area-of-effect weapons and abilities during add clear."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <!-- COMMON MISTAKES -->
                <TextBlock Text="COMMON MISTAKES"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF1A1A"
                           Margin="0,10,0,15"/>


                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="• Accidentally collecting a third Taken Strength and dying."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="• Collecting an orb out of order and disrupting the team's rotation."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="• Taking too long to cleanse a player trapped by Umbral Enervation."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="• Having the cleanser already hold two stacks when they cleanse another player."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="• Letting Morgeth reach 100% strength during DPS."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="• Accidentally killing an Ogre while attempting the Forever Fight challenge."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,20"/>


                        <!-- VIDEO GUIDE -->
                        <TextBlock Text="VIDEO GUIDE"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"
                                   Margin="0,5,0,12"/>

                        <Border Background="#101010"
                                BorderBrush="#292929"
                                BorderThickness="1"
                                Padding="15">

                            <StackPanel>

                                <TextBlock Text="MORGETH ENCOUNTER GUIDE"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,0,0,12"/>

                                <local:YouTubePlayer VideoId="MZI4IfFqSVE"
                                                     Height="400"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>