<Page x:Class="DaBoyzApp.Pages.OryxPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:DaBoyzApp.Controls"
      Background="Transparent">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="KING'S FALL  /  FINAL ENCOUNTER"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#B0B0B0"/>

                <TextBlock Text="ORYX"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,2,0,0"/>

                <TextBlock Text="THE TAKEN KING"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FF1A1A"
                           Margin="0,4,0,0"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Content="BACK TO KING'S FALL"
                    Width="190"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="#161616"
                    Foreground="#B0B0B0"
                    BorderBrush="#292929"
                    BorderThickness="1"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Padding="18,10"
                    Cursor="Hand"
                    Click="BackButton_Click"/>

        </Grid>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,25,0,0"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- OBJECTIVE -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="OBJECTIVE"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Defeat Oryx, the Taken King, by completing the Torn Between Dimensions sequence, creating four Corrupted Light bombs, stealing the Aura of Immortality from the Vessel of Oryx, and detonating the bombs to stagger Oryx."
                                   FontSize="14"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="CORE LOOP: Oryx SLAMS PLATE → TORN RUN → KILL OGRES → KILL KNIGHTS → STEAL AURA → DETONATE BOMBS → DAMAGE ORYX"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"
                                   TextWrapping="Wrap"
                                   Margin="0,15,0,0"/>

                    </StackPanel>

                </Border>

                <!-- TEAM SETUP -->
                <TextBlock Text="TEAM SETUP"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <UniformGrid Columns="3"
                             Margin="0,0,0,15">

                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="0,0,8,0">

                        <StackPanel>

                            <TextBlock Text="4 × PLATE HOLDERS"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Each player owns one plate and is responsible for killing the Light-Eater Ogre near it."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="4,0,4,0">

                        <StackPanel>

                            <TextBlock Text="2 × FLOATERS"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Clear adds, assist with Knights, and cover plate responsibilities when necessary."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="8,0,0,0">

                        <StackPanel>

                            <TextBlock Text="TORN PLAYER"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Navigate the Ascendant path and collect the Blightguard to obtain Brand Claimer."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>

                <!-- STARTING ENCOUNTER -->
                <TextBlock Text="STARTING THE ENCOUNTER"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="1 — APPROACH THE ORB"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Approach the black orb at the front of the arena to summon Oryx. Use this time to confirm plate assignments and roles."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="2 — CLEAR THE INITIAL ADDS"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Taken enemies begin spawning around the arena. Clear the initial wave so the team can safely execute the mechanic."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="3 — ORYX SLAMS A PLATE"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Oryx moves to one of the four plates and slams it. The plate he hits becomes the starting point for the Torn Between Dimensions sequence."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

                <!-- TORN -->
                <TextBlock Text="TORN BETWEEN DIMENSIONS"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="ACTIVATE THE STARTING PLATE"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="The player assigned to Oryx's starting plate jumps onto it. A random player becomes Torn Between Dimensions."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="CALL THE NEXT PLATE"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="The player on the starting plate identifies the glowing green destination marker and calls out the plate that needs to be activated."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="BUILD THE PATH"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="The called plate holder activates their plate, creating the Ascendant path for the Torn player."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="COLLECT THE BLIGHTGUARD"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="The Torn player follows the path and collects the Blightguard piece. After the third collection, the player receives Brand Claimer."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

                <!-- OGRES -->
                <TextBlock Text="LIGHT-EATER OGRES"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="FOUR OGRES — FOUR BOMBS"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="One Light-Eater Ogre spawns near each plate. Each Ogre must be killed before it can cause problems for the team."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="CORRUPTED LIGHT"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="When a Light-Eater Ogre dies, it leaves behind a Corrupted Light bomb. Do not detonate the bomb immediately."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="KEEP TRACK OF YOUR OGRE"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Remember which Ogre you killed. This becomes extremely important for the Hands Off challenge."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

                <!-- KNIGHTS -->
                <TextBlock Text="LIGHT-EATER KNIGHTS"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="PROTECT THE BOMBS"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="After a Light-Eater Ogre dies, a Light-Eater Knight spawns across the arena. The Knight attempts to reach and consume the corresponding Corrupted Light."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="KILL THE KNIGHTS"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Kill the Knights quickly. If a Knight reaches its bomb, the Corrupted Light is lost and the damage phase can be compromised."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

                <!-- VESSEL -->
                <TextBlock Text="VESSEL OF ORYX"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="THE VESSEL APPEARS"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="After the third Blightguard is collected, the Vessel of Oryx enters the arena carrying the Aura of Immortality."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="STEAL THE AURA"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="The player holding Brand Claimer must approach the Vessel and hold interact to steal the Aura of Immortality."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="KILL THE VESSEL"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Once the aura has been stolen, the team should kill the Vessel immediately. The player holding the aura becomes the center of the team's protection."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

                <!-- DETONATION -->
                <TextBlock Text="CORRUPTED LIGHT DETONATION"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="WAIT FOR ORYX"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Do not detonate the bombs as soon as they spawn. Wait for Oryx to begin calling upon the Darkness."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="RUN TO YOUR BOMBS"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="The four assigned players move to their respective Corrupted Light bombs. The team should coordinate the detonation together."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="DETONATE"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Stand inside the Corrupted Light until the game confirms that you have detonated it. Immediately return to the Aura of Immortality."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="STUN ORYX"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>

                        <TextBlock Text="The synchronized detonations interrupt Oryx's wipe attack and expose his chest, creating the damage window."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

                <!-- DAMAGE -->
                <TextBlock Text="DAMAGE PHASE"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="GROUP IN THE AURA"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Everyone should be inside the Aura of Immortality when the bombs detonate. Players outside the aura will not survive the Darkness."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="SHOOT ORYX'S CHEST"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Once Oryx is staggered and his chest opens, unload all available damage into the critical spot."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="MORE BOMBS = MORE TIME"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="The more Corrupted Light bombs detonated together, the longer Oryx remains vulnerable."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

                <!-- INTERMISSION -->
                <TextBlock Text="INTERMISSION"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <UniformGrid Columns="2"
                             Margin="0,0,0,15">

                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="22"
                            Margin="0,0,8,0">

                        <StackPanel>

                            <TextBlock Text="BOMB BARRAGE"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Oryx launches tracking projectiles at the fireteam. Keep moving continuously and avoid standing still. Killing the appropriate Taken Knights can end the barrage."
                                       FontSize="13"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="22"
                            Margin="8,0,0,0">

                        <StackPanel>

                            <TextBlock Text="SHADE OF ORYX"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Oryx creates a dark arena and teleports players inside one at a time. Find and kill the Shade of Oryx before the timer expires."
                                       FontSize="13"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>

                <!-- REPEAT -->
                <TextBlock Text="REPEAT THE CYCLE"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="EVERY DAMAGE CYCLE"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="After the intermission, return to your assigned positions. Oryx slams another plate, another Torn sequence begins, new Light-Eater Ogres spawn, and the team prepares another set of Corrupted Light bombs."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="ROTATE FOR HANDS OFF"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>

                        <TextBlock Text="For the Hands Off challenge, rotate plate assignments after each damage phase so players do not kill the same Light-Eater Ogre or Knight more than once."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

                <!-- FINAL STAND -->
                <TextBlock Text="FINAL STAND"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="ORYX MOVES TO THE FRONT"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="When Oryx reaches his final health segment, he moves to the front of the arena and begins the Final Stand."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="TWO MORE OGRES"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Two Light-Eater Ogres spawn sequentially and create two final Corrupted Light bombs. No Light-Eater Knights spawn during this sequence."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="DETONATE ONE AT A TIME"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Use one bomb to interrupt Oryx's Darkness attack and create another damage window. Save the second bomb for the next wipe attempt."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="FINISH THE TAKEN KING"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>

                        <TextBlock Text="Use the final damage window to finish Oryx before the second interruption is exhausted."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

                <!-- ROLES -->
                <TextBlock Text="ROLES"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <UniformGrid Columns="3"
                             Margin="0,0,0,15">

                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="0,0,8,0">

                        <StackPanel>

                            <TextBlock Text="PLATE HOLDERS"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Activate your plate, kill your Light-Eater Ogre, protect the bomb, and rotate positions when required."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="4,0,4,0">

                        <StackPanel>

                            <TextBlock Text="FLOATERS"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Clear adds, assist with Knights, and cover plate players when needed."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="8,0,0,0">

                        <StackPanel>

                            <TextBlock Text="BRAND CLAIMER"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Complete the third Torn run, steal the Vessel's Aura of Immortality, and keep the team protected."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>

                <!-- COMMON MISTAKES -->
                <TextBlock Text="COMMON MISTAKES"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="• Light-Eater Knights reaching and consuming Corrupted Light"
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="• Torn player missing the Ascendant path"
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="• Delaying plate activation"
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="• Detonating Corrupted Light too early"
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="• Players failing to return to the Aura of Immortality"
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="• Losing track of which Ogre each player killed"
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="• Running out of damage because bombs are detonated individually"
                                   FontSize="13"
                                   Foreground="#B0B0B0"/>

                    </StackPanel>

                </Border>

                <!-- CHALLENGE -->
                <TextBlock Text="WEEKLY CHALLENGE — HANDS OFF"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="CHALLENGE REQUIREMENT"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>

