<Page x:Class="DaBoyzApp.Pages.WarpriestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:DaBoyzApp.Controls"
      Background="Transparent">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="KING'S FALL  /  ENCOUNTER 02"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#B0B0B0"/>

                <TextBlock Text="WARPRIEST"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,2,0,0"/>

                <TextBlock Text="WARPRIEST'S COURT"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FF1A1A"
                           Margin="0,4,0,0"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Content="BACK TO KING'S FALL"
                    Width="190"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="#161616"
                    Foreground="#B0B0B0"
                    BorderBrush="#292929"
                    BorderThickness="1"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Padding="18,10"
                    Cursor="Hand"
                    Click="BackButton_Click"/>

        </Grid>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,25,0,0"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- OBJECTIVE -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="OBJECTIVE"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Activate the three plates in the correct glyph sequence to summon the Warpriest, then use the Brand of the Initiate to damage him."
                                   FontSize="14"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="CORE LOOP: GLYPH SEQUENCE → BRAND → DAMAGE → OCULUS → REPEAT"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"
                                   TextWrapping="Wrap"
                                   Margin="0,15,0,0"/>

                    </StackPanel>

                </Border>

                <!-- ROOM LAYOUT -->
                <TextBlock Text="ROOM LAYOUT"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <UniformGrid Columns="3"
                             Margin="0,0,0,15">

                    <!-- LEFT -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="0,0,8,0">

                        <StackPanel>

                            <TextBlock Text="LEFT"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Left plate and left monolith."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                    <!-- MIDDLE -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="4,0,4,0">

                        <StackPanel>

                            <TextBlock Text="MIDDLE"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Center plate and central monolith."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                    <!-- RIGHT -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="8,0,0,0">

                        <StackPanel>

                            <TextBlock Text="RIGHT"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Right plate and right monolith."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>

                <!-- GLYPH SEQUENCE -->
                <TextBlock Text="GLYPH SEQUENCE"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="STEP 1 — START THE SEQUENCE"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="A player stands on the middle plate to begin reading the glyph sequence. Look behind the monoliths to determine which plate starts the sequence."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="STEP 2 — CALL OUT THE FIRST PLATE"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="The glowing monolith identifies the first plate. The player on the middle plate calls out LEFT, MIDDLE, or RIGHT so the appropriate player can activate it."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="STEP 3 — FIND THE SECOND PLATE"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Once the first plate is activated, the player standing on it looks for the next glowing monolith and calls out the next plate."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="STEP 4 — ACTIVATE THE FINAL PLATE"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="The third and final plate completes the sequence. The player standing on that plate receives the Brand of the Initiate."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="IMPORTANT"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>

                        <TextBlock Text="Do not randomly activate plates. The order is determined by the glowing glyphs on the monoliths."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0"/>

                    </StackPanel>

                </Border>

                <!-- DAMAGE PHASE -->
                <TextBlock Text="DAMAGE PHASE"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="BRAND OF THE INITIATE"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="The player who activates the final plate receives the Brand of the Initiate. The Brand creates an aura around its holder that allows the rest of the fireteam to damage the Warpriest."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="GROUP UP"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="The team groups around the Brand holder and damages the Warpriest while remaining inside the Brand's aura."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="BRAND CLAIMER"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="A player kills a Blightguard to obtain Brand Claimer. They return to the group and take the Brand from the current holder before the timer expires."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="ROTATE THE BRAND"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Continue transferring the Brand using Brand Claimer to extend the damage phase. The team should already know who is getting each successive Brand Claimer."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

                <!-- OCULUS -->
                <TextBlock Text="OCULUS"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="DAMAGE PHASE ENDS"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="When the Brand expires, Warpriest summons the Oculus. Everyone must immediately get behind a monolith to survive the incoming attack."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="MONOLITH PROTECTION"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="The fireteam must hide behind one of the three monoliths. The chosen monolith is consumed after protecting the team, so each successful damage cycle removes one possible hiding location."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,18"/>

                        <TextBlock Text="PLAN AHEAD"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>

                        <TextBlock Text="Before the damage phase ends, decide which monolith everyone will use. Do not wait until the Oculus appears to figure it out."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

                <!-- ROLES -->
                <TextBlock Text="ROLES"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <UniformGrid Columns="3"
                             Margin="0,0,0,15">

                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="0,0,8,0">

                        <StackPanel>

                            <TextBlock Text="PLATE PLAYERS"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Watch for the glyph callouts and activate the correct plates in sequence."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="4,0,4,0">

                        <StackPanel>

                            <TextBlock Text="BRAND CLAIMER"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Kill the Blightguard and transfer the Brand before the timer expires."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="8,0,0,0">

                        <StackPanel>

                            <TextBlock Text="DAMAGE TEAM"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Stay inside the Brand aura and maximize damage during the DPS window."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>

                <!-- COMMON MISTAKES -->
                <TextBlock Text="COMMON MISTAKES"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="• Activating plates in the wrong order"
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="• Missing the glyph callout"
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="• Waiting too long to transfer the Brand"
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="• Having nobody assigned to Brand Claimer"
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="• Forgetting which monolith the team will use"
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="• Staying exposed when the Oculus appears"
                                   FontSize="13"
                                   Foreground="#B0B0B0"/>

                    </StackPanel>

                </Border>

                <!-- VIDEO -->
                <TextBlock Text="VIDEO GUIDE"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,5,0,12"/>

                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="15"
                        Margin="0,0,0,25">

                    <StackPanel>

                        <TextBlock Text="WARPRIEST ENCOUNTER GUIDE"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,12"/>

                        <local:YouTubePlayer VideoId="iSl7mz64kMI"
                                             Height="400"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>