<Page x:Class="DaBoyzApp.Pages.KingsFallPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="DESTINY 2  /  RAIDS"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#B0B0B0"/>

                <TextBlock Text="KING'S FALL"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,2,0,0"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Content="BACK TO RAIDS"
                    Width="160"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="#161616"
                    Foreground="#B0B0B0"
                    BorderBrush="#292929"
                    BorderThickness="1"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Padding="18,10"
                    Cursor="Hand"
                    Click="BackButton_Click"/>

        </Grid>


        <!-- DESCRIPTION -->
        <TextBlock Grid.Row="1"
                   Text="King's Fall — explore encounters, mechanics, recommended loadouts, loot, and video guides."
                   FontSize="13"
                   Foreground="#B0B0B0"
                   Margin="0,15,0,25"/>


        <!-- ENCOUNTERS -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- RAID OVERVIEW -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,25">

                    <StackPanel>

                        <TextBlock Text="RAID OVERVIEW"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>

                        <TextBlock Text="Kings Fall"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="Journey through Oryx's Dreadnaught and put an end to the taken. Kings Fall features five encounters, including four boss fights, plate mechanics, and is heavily focused on time."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,8,0,0"/>

                        <Grid Margin="0,20,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="LOCATION"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#666666"/>

                                <TextBlock Text="DREADNAUGHT"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="FIRETEAM"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#666666"/>

                                <TextBlock Text="6 PLAYERS"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ENCOUNTERS"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#666666"/>

                                <TextBlock Text="6"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ENCOUNTERS TITLE -->
                <TextBlock Text="ENCOUNTERS"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,12"/>


                <!-- ENCOUNTER CARDS -->
                <UniformGrid Columns="2">


                    <!-- TOTEMS -->
                    <Button Margin="0,0,12,12"
                            Height="165"
                            Background="#161616"
                            BorderBrush="#292929"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            BorderThickness="1"
                            Click="Totems_Click">

                        <Grid Margin="20">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- KING'S FALL ICON -->
                            <Image Grid.Column="0"
                                   Source="/Assets/Icons/kingsfall.png"
                                   Width="60"
                                   Height="60"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>


                            <!-- ENCOUNTER INFO -->
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="18,0,0,0">

                                <TextBlock Text="TOTEMS"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="The Basilica"
                                           FontSize="12"
                                           Foreground="#B0B0B0"
                                           Margin="0,5,0,12"/>

                                <TextBlock Text="VIEW ENCOUNTER  →"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#FF1A1A"/>

                            </StackPanel>

                        </Grid>

                    </Button>


                    <!-- WARPRIEST -->
                    <Button Margin="12,0,0,12"
                            Height="165"
                            Background="#161616"
                            BorderBrush="#292929"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            BorderThickness="1"
                            Click="Warpriest_Click">

                        <Grid Margin="20">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- KING'S FALL ICON -->
                            <Image Grid.Column="0"
                                   Source="/Assets/Icons/kingsfall.png"
                                   Width="60"
                                   Height="60"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>


                            <!-- ENCOUNTER INFO -->
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="18,0,0,0">

                                <TextBlock Text="WARPRIEST"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="Warpriest's Court"
                                           FontSize="12"
                                           Foreground="#B0B0B0"
                                           Margin="0,5,0,12"/>

                                <TextBlock Text="VIEW ENCOUNTER  →"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#FF1A1A"/>

                            </StackPanel>

                        </Grid>

                    </Button>


                    <!-- GOLGOROTH -->
                    <Button Margin="0,12,12,12"
                            Height="165"
                            Background="#161616"
                            BorderBrush="#292929"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            BorderThickness="1"
                            Click="Golgoroth_Click">

                        <Grid Margin="20">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- KING'S FALL ICON -->
                            <Image Grid.Column="0"
                                   Source="/Assets/Icons/kingsfall.png"
                                   Width="60"
                                   Height="60"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>


                            <!-- ENCOUNTER INFO -->
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="18,0,0,0">

                                <TextBlock Text="GOLGOROTH"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="The Pit"
                                           FontSize="12"
                                           Foreground="#B0B0B0"
                                           Margin="0,5,0,12"/>

                                <TextBlock Text="VIEW ENCOUNTER  →"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#FF1A1A"/>

                            </StackPanel>

                        </Grid>

                    </Button>


                    <!-- DAUGHTERS -->
                    <Button Margin="12,12,0,12"
                            Height="165"
                            Background="#161616"
                            BorderBrush="#292929"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            BorderThickness="1"
                            Click="Daughters_Click">

                        <Grid Margin="20">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- KING'S FALL ICON -->
                            <Image Grid.Column="0"
                                   Source="/Assets/Icons/kingsfall.png"
                                   Width="60"
                                   Height="60"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>


                            <!-- ENCOUNTER INFO -->
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="18,0,0,0">

                                <TextBlock Text="DAUGHTERS OF ORYX"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="The Threshold"
                                           FontSize="12"
                                           Foreground="#B0B0B0"
                                           Margin="0,5,0,12"/>

                                <TextBlock Text="VIEW ENCOUNTER  →"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#FF1A1A"/>

                            </StackPanel>

                        </Grid>

                    </Button>


                    <!-- ORYX -->
                    <Button Margin="0,12,12,12"
                            Height="165"
                            Background="#161616"
                            BorderBrush="#292929"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            BorderThickness="1"
                            Click="Oryx_Click">

                        <Grid Margin="20">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- KING'S FALL ICON -->
                            <Image Grid.Column="0"
                                   Source="/Assets/Icons/kingsfall.png"
                                   Width="60"
                                   Height="60"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>


                            <!-- ENCOUNTER INFO -->
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="18,0,0,0">

                                <TextBlock Text="ORYX"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="The Taken King"
                                           FontSize="12"
                                           Foreground="#B0B0B0"
                                           Margin="0,5,0,12"/>

                                <TextBlock Text="VIEW ENCOUNTER  →"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#FF1A1A"/>

                            </StackPanel>

                        </Grid>

                    </Button>


                </UniformGrid>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>