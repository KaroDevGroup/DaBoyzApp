<Page x:Class="DaBoyzApp.Pages.DefeatSanctifiedMindPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="GARDEN OF SALVATION  /  ENCOUNTER 04"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#B0B0B0"/>

                <TextBlock Text="DEFEAT THE SANCTIFIED MIND"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,2,0,0"/>

                <TextBlock Text="SANCTIFIED MIND"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FF1A1A"
                           Margin="0,4,0,0"/>

            </StackPanel>


            <Button Grid.Column="1"
                    Content="BACK TO GARDEN"
                    Width="170"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="#161616"
                    Foreground="#B0B0B0"
                    BorderBrush="#292929"
                    BorderThickness="1"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Padding="18,10"
                    Cursor="Hand"
                    Click="BackButton_Click"/>

        </Grid>


        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,25,0,0"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>


                <!-- OBJECTIVE -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="OBJECTIVE"
                                   Foreground="#E00000"
                                   FontSize="13"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Charge the correct relays by collecting and depositing Voltaic Motes, stabilize the arena, and use the Sanctified Mind's tether points to open its damage window. Repeat the cycle until the boss is defeated."
                                   Foreground="White"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>


                <!-- ENCOUNTER FLOW -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="ENCOUNTER FLOW"
                                   Foreground="#E00000"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>


                        <TextBlock Text="01  Start the encounter and clear the Vex around the arena."
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="02  The Sanctified Mind begins moving around the arena. Control enemies while watching its position."
                                   Foreground="White"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="03  Destroy the boss's shoulder or knee to determine the side of the arena where the next mote portal appears."
                                   Foreground="White"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="04  Enter the portal and defeat Vex inside the mote area."
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="05  Kill the Minotaurs inside to create Voltaic Motes."
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="06  Collect the required motes and return through the portal."
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="07  Deposit the motes into the appropriate relay while the rest of the team prevents Vex sacrifices."
                                   Foreground="White"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="08  Repeat the mote cycle until the necessary relays are fully charged."
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="09  Connect the tether from the relay through the fireteam to the Sanctified Mind to open the damage phase."
                                   Foreground="White"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="10  Damage the Sanctified Mind and repeat the cycle until the boss is defeated."
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                    </StackPanel>

                </Border>


                <!-- ROLES -->
                <TextBlock Text="ROLES"
                           Foreground="#E00000"
                           FontSize="13"
                           FontWeight="Bold"
                           Margin="0,5,0,12"/>


                <UniformGrid Columns="3"
                             Margin="0,0,0,15">


                    <!-- MOTE TEAM -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18"
                            Margin="0,0,8,0">

                        <StackPanel>

                            <TextBlock Text="MOTE TEAM"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Enter the mote portal, kill Minotaurs, collect the required motes, and return quickly. Communicate when you are ready to deposit."
                                       Foreground="#B0B0B0"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- DEFENSE TEAM -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18"
                            Margin="4,0,4,0">

                        <StackPanel>

                            <TextBlock Text="DEFENSE TEAM"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Defend the active relay, kill Vex attempting to sacrifice, and keep enemy pressure under control while the mote team is away."
                                       Foreground="#B0B0B0"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- TETHER TEAM -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18"
                            Margin="8,0,0,0">

                        <StackPanel>

                            <TextBlock Text="TETHER TEAM"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Coordinate the tether from the active relay to the Sanctified Mind. Make sure everyone is positioned correctly before starting the chain."
                                       Foreground="#B0B0B0"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>


                <!-- IMPORTANT MECHANICS -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="IMPORTANT MECHANICS"
                                   Foreground="#E00000"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>


                        <TextBlock Text="VOLTAIC MOTES"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Minotaurs inside the mote portals drop Voltaic Motes. Collect the required amount and return through the portal to deposit them into the correct relay."
                                   Foreground="#B0B0B0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,15"/>


                        <TextBlock Text="MOTE PORTALS"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Breaking the Sanctified Mind's shoulder or knee determines which side of the arena receives the portal. Call the side before sending the mote team."
                                   Foreground="#B0B0B0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,15"/>


                        <TextBlock Text="RELAY DEFENSE"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                        <TextBlock Text="While the mote team is away, Vex will attack the active relay. Stop sacrificing enemies before they reach it and keep the relay stable."
                                   Foreground="#B0B0B0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,15"/>


                        <TextBlock Text="TETHER"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Once the required relay is charged, connect its tether through the fireteam to the Sanctified Mind. A successful connection exposes the boss for damage."
                                   Foreground="#B0B0B0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,15"/>


                        <TextBlock Text="DAMAGE PHASE"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                        <TextBlock Text="When the tether successfully reaches the boss, unload your strongest damage weapons and abilities. Be ready to repeat the entire mote cycle if the boss survives."
                                   Foreground="#B0B0B0"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>


                <!-- QUICK REFERENCE -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="QUICK REFERENCE"
                                   Foreground="#E00000"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>


                        <TextBlock Text="• Watch which side the boss opens"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Send the mote team through the portal"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Kill Minotaurs → collect motes"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Return and deposit into the correct relay"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Defend against Vex sacrifices"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Repeat until the relay is charged"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Build the tether to the boss"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Damage the Sanctified Mind"
                                   Foreground="White"
                                   FontSize="14"/>

                    </StackPanel>

                </Border>


                <!-- CHALLENGE -->
                <Border Background="#161616"
                        BorderBrush="#E00000"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="CHALLENGE"
                                   Foreground="#E00000"
                                   FontSize="13"
                                   FontWeight="Bold"/>

                        <TextBlock Text="ZERO TO ONE HUNDRED"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="Fully charge a relay from empty to full in a single mote deposit sequence. Coordinate the mote team and deposits carefully so the relay reaches maximum charge without requiring another partial cycle."
                                   Foreground="#B0B0B0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <!-- COMMON MISTAKES -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="COMMON MISTAKES"
                                   Foreground="#E00000"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>


                        <TextBlock Text="• Sending the mote team to the wrong side"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Losing motes before reaching the relay"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Allowing Vex to sacrifice at the active relay"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Starting the tether before everyone is positioned"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Failing to communicate which relay is being charged"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Poor DPS coordination during the damage window"
                                   Foreground="White"
                                   FontSize="14"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>