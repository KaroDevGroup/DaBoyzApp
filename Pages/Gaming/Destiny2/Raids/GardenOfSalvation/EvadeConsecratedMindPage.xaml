<Page x:Class="DaBoyzApp.Pages.EvadeConsecratedMindPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="GARDEN OF SALVATION  /  ENCOUNTER 01"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#B0B0B0"/>

                <TextBlock Text="EVADE THE CONSECRATED MIND"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,2,0,0"/>

                <TextBlock Text="EMBRACE"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FF1A1A"
                           Margin="0,4,0,0"/>

            </StackPanel>


            <Button Grid.Column="1"
                    Content="BACK TO GARDEN"
                    Width="170"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="#161616"
                    Foreground="#B0B0B0"
                    BorderBrush="#292929"
                    BorderThickness="1"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Padding="18,10"
                    Cursor="Hand"
                    Click="BackButton_Click"/>

        </Grid>


        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,25,0,0"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>


                <!-- OBJECTIVE -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="OBJECTIVE"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>

                        <TextBlock Text="Escape the Consecrated Mind."
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="Open the Vex barriers by creating tether chains while leapfrogging two teams through the Black Garden. One team advances toward the next barrier while the other stays with the Consecrated Mind and collects every Voltaic Overflow it creates."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <!-- ENCOUNTER FLOW -->
                <TextBlock Text="ENCOUNTER FLOW"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF1A1A"
                           Margin="0,10,0,15"/>


                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>


                        <!-- STEP 1 -->
                        <TextBlock Text="1 — START THE TETHER"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Locate the floating Vex tether source and the receiver on the first barrier. Shoot the source to begin the chain, then have Guardians position themselves between the source and receiver until the tether reaches the barrier."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,20"/>


                        <!-- STEP 2 -->
                        <TextBlock Text="2 — SPLIT INTO TWO TEAMS"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Once the first barrier opens, divide into two teams of three. The Forward team moves through the barrier and begins clearing the next area. The Boss team remains behind with the Consecrated Mind."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,20"/>


                        <!-- STEP 3 -->
                        <TextBlock Text="3 — CLEAR THE NEXT AREA"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="The Forward team clears Vex enemies and kills the Angelic Hydra protecting the next tether source. Once the area is safe, prepare the tether chain for the next barrier."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,20"/>


                        <!-- STEP 4 -->
                        <TextBlock Text="4 — COLLECT VOLTAIC OVERFLOW"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="The Consecrated Mind periodically creates Voltaic Overflow charges. The Boss team must collect every charge. If an Overflow is left on the ground, it detonates and wipes the fireteam."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,20"/>


                        <!-- STEP 5 -->
                        <TextBlock Text="5 — LEAPFROG THE TEAMS"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="After the Forward team opens the next barrier, the Consecrated Mind moves forward into the previous area. The Boss team now advances while the original Forward team becomes responsible for collecting the next Voltaic Overflow."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,20"/>


                        <!-- STEP 6 -->
                        <TextBlock Text="6 — REPEAT THE ROTATION"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Continue alternating responsibilities. The team ahead clears enemies and opens the next barrier. The team behind stays with the boss and catches its Voltaic Overflow."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,20"/>


                        <!-- STEP 7 -->
                        <TextBlock Text="7 — FINAL BARRIER"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="The final barrier contains three tether receivers. Complete all three tether paths to open the route into the final chase area. Once the first tether is established, communicate clearly so the remaining two chains can be completed."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,20"/>


                        <!-- STEP 8 -->
                        <TextBlock Text="8 — CHASE THE MIND"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Once the final barrier opens, all six Guardians regroup. Chase the Consecrated Mind through the open field while collecting the final Voltaic Overflow charges it creates."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,20"/>


                        <!-- STEP 9 -->
                        <TextBlock Text="9 — REACH THE END"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Push through the final enemies and reach the far end of the area. Once the fireteam reaches the end of the chase route, the encounter completes."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"/>

                    </StackPanel>

                </Border>


                <!-- ROLES -->
                <TextBlock Text="ROLES"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF1A1A"
                           Margin="0,10,0,15"/>


                <UniformGrid Columns="3"
                             HorizontalAlignment="Stretch"
                             Margin="0,0,0,15">


                    <!-- FORWARD TEAM -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="0,0,8,0">

                        <StackPanel>

                            <TextBlock Text="FORWARD TEAM"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="3 PLAYERS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF1A1A"
                                       Margin="0,4,0,10"/>

                            <TextBlock Text="Push ahead, clear Vex, kill Angelics, and build the tether chain to open each barrier."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"/>

                        </StackPanel>

                    </Border>


                    <!-- BOSS TEAM -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="4,0,4,0">

                        <StackPanel>

                            <TextBlock Text="BOSS TEAM"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="3 PLAYERS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF1A1A"
                                       Margin="0,4,0,10"/>

                            <TextBlock Text="Stay with the Consecrated Mind, watch for Voltaic Overflow, and collect every charge before it detonates."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"/>

                        </StackPanel>

                    </Border>


                    <!-- ROTATION -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            Padding="20"
                            Margin="8,0,0,0">

                        <StackPanel>

                            <TextBlock Text="ROTATION"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="EVERY BARRIER"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF1A1A"
                                       Margin="0,4,0,10"/>

                            <TextBlock Text="The teams swap responsibilities whenever the Consecrated Mind moves into the newly opened area."
                                       FontSize="12"
                                       Foreground="#B0B0B0"
                                       TextWrapping="Wrap"
                                       LineHeight="20"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>


                <!-- IMPORTANT MECHANICS -->
                <TextBlock Text="IMPORTANT MECHANICS"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF1A1A"
                           Margin="0,10,0,15"/>


                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>


                        <TextBlock Text="VOLTAIC OVERFLOW"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="The Consecrated Mind periodically launches a Voltaic Overflow charge. Every charge must be collected before it detonates. The pickup applies a 2:30 Voltaic Overflow debuff, preventing that player from safely collecting another charge while the debuff remains active."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,18"/>


                        <TextBlock Text="TETHER SOURCE"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Shoot the floating Vex box to activate it. The tether automatically connects to nearby valid Guardians. Position the team in a controlled line so the final player can connect to the barrier receiver."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,18"/>


                        <TextBlock Text="ANGELIC HYDRA"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="The Angelic protects progression in the forward rooms. Kill it to unlock the tether source and allow the team to open the next barrier."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,18"/>


                        <TextBlock Text="LEAPFROGGING"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="The encounter is designed around two teams constantly trading positions. The team that opens a barrier becomes the team moving forward, while the team that was ahead falls back to handle Voltaic Overflow after the boss moves."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,18"/>


                        <TextBlock Text="FINAL CHASE"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="After the final barrier, the entire fireteam reunites. There are additional Voltaic Overflow charges during the chase, so don't stop moving while still watching for the pickups."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"/>

                    </StackPanel>

                </Border>


                <!-- QUICK REFERENCE -->
                <TextBlock Text="QUICK REFERENCE"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF1A1A"
                           Margin="0,10,0,15"/>


                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <UniformGrid Columns="2">


                        <Border Background="#101010"
                                BorderBrush="#292929"
                                BorderThickness="1"
                                Padding="18"
                                Margin="0,0,6,6">

                            <StackPanel>

                                <TextBlock Text="FORWARD"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#FF1A1A"/>

                                <TextBlock Text="Clear room → Kill Angelic → Activate source → Tether barrier"
                                           FontSize="12"
                                           Foreground="#B0B0B0"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                        </Border>


                        <Border Background="#101010"
                                BorderBrush="#292929"
                                BorderThickness="1"
                                Padding="18"
                                Margin="6,0,0,6">

                            <StackPanel>

                                <TextBlock Text="BOSS"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#FF1A1A"/>

                                <TextBlock Text="Watch Mind → Collect Overflow → Swap when boss moves"
                                           FontSize="12"
                                           Foreground="#B0B0B0"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                        </Border>


                        <Border Background="#101010"
                                BorderBrush="#292929"
                                BorderThickness="1"
                                Padding="18"
                                Margin="0,6,6,0">

                            <StackPanel>

                                <TextBlock Text="OVERFLOW"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#FF1A1A"/>

                                <TextBlock Text="Collect every charge. Never let one remain on the ground."
                                           FontSize="12"
                                           Foreground="#B0B0B0"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                        </Border>


                        <Border Background="#101010"
                                BorderBrush="#292929"
                                BorderThickness="1"
                                Padding="18"
                                Margin="6,6,0,0">

                            <StackPanel>

                                <TextBlock Text="FINAL"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#FF1A1A"/>

                                <TextBlock Text="Regroup → Chase Mind → Collect final Overflows → Finish"
                                           FontSize="12"
                                           Foreground="#B0B0B0"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                        </Border>

                    </UniformGrid>

                </Border>


                <!-- CHALLENGE -->
                <TextBlock Text="CHALLENGE"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF1A1A"
                           Margin="0,10,0,15"/>


                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="LEFTOVERS"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Complete the first encounter without killing the Cyclops enemies after they spawn."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,6,0,10"/>

                        <TextBlock Text="Avoid damaging the Cyclops during normal add clear. Focus on the required Vex, Angelics, tether mechanics, and Voltaic Overflow while leaving the Cyclops alive."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   LineHeight="22"/>

                    </StackPanel>

                </Border>


                <!-- COMMON MISTAKES -->
                <TextBlock Text="COMMON MISTAKES"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FF1A1A"
                           Margin="0,10,0,15"/>


                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="• Letting a Voltaic Overflow sit on the ground too long."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="• Having the same player collect multiple Overflows while their debuff is active."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="• Starting a tether before dangerous enemies have been cleared."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="• Breaking the tether by moving out of position."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="• Forgetting to swap teams when the Consecrated Mind moves."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="• Rushing the final barrier instead of clearly coordinating all three tether chains."
                                   FontSize="13"
                                   Foreground="#B0B0B0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>


            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>