<Page x:Class="DaBoyzApp.Pages.DefeatConsecratedMindPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#080808">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="GARDEN OF SALVATION  /  ENCOUNTER 03"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#B0B0B0"/>

                <TextBlock Text="DEFEAT THE CONSECRATED MIND"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,2,0,0"/>

                <TextBlock Text="MIND"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FF1A1A"
                           Margin="0,4,0,0"/>

            </StackPanel>


            <Button Grid.Column="1"
                    Content="BACK TO GARDEN"
                    Width="170"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="#161616"
                    Foreground="#B0B0B0"
                    BorderBrush="#292929"
                    BorderThickness="1"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Padding="18,10"
                    Cursor="Hand"
                    Click="BackButton_Click"/>

        </Grid>


        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,25,0,0"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>


                <!-- OBJECTIVE -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="OBJECTIVE"
                                   Foreground="#E00000"
                                   FontSize="13"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Collect Voltaic Motes from Vex Minotaurs, deposit them into the correct relay, and use the resulting Enlightened buff to damage the Consecrated Mind. Repeat the process while progressing through each relay until the boss is defeated."
                                   Foreground="White"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>


                <!-- ENCOUNTER FLOW -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="ENCOUNTER FLOW"
                                   Foreground="#E00000"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>


                        <TextBlock Text="01  Start the encounter and clear the Vex around the first relay."
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="02  Kill Vex Minotaurs to spawn Voltaic Motes."
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="03  Collect the required motes and deposit them into the relay."
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="04  The relay grants Enlightened, allowing the team to destroy shielded Vex."
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="05  The Consecrated Mind moves between relays and eventually exposes its weak points."
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="06  When the boss reaches a relay, use the tether to damage and stagger it."
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="07  Continue collecting motes and activating the next relay while controlling enemy waves."
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="08  Keep the boss team and mote team coordinated so the relay is ready when the boss arrives."
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="09  Repeat the rotation until the final damage sequence."
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="10  Finish the Consecrated Mind before it escapes the final relay."
                                   Foreground="White"
                                   FontSize="14"/>

                    </StackPanel>

                </Border>


                <!-- ROLES -->
                <TextBlock Text="ROLES"
                           Foreground="#E00000"
                           FontSize="13"
                           FontWeight="Bold"
                           Margin="0,5,0,12"/>


                <UniformGrid Columns="3"
                             Margin="0,0,0,15">


                    <!-- MOTE TEAM -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18"
                            Margin="0,0,8,0">

                        <StackPanel>

                            <TextBlock Text="MOTE TEAM"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Kill Minotaurs, collect their Voltaic Motes, and deposit them into the active relay. Communicate when the required amount has been collected."
                                       Foreground="#B0B0B0"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- BOSS TEAM -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18"
                            Margin="4,0,4,0">

                        <StackPanel>

                            <TextBlock Text="BOSS TEAM"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Track the Consecrated Mind and control enemies around its current position. Prepare the relay before the boss arrives."
                                       Foreground="#B0B0B0"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- RELAY SUPPORT -->
                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18"
                            Margin="8,0,0,0">

                        <StackPanel>

                            <TextBlock Text="RELAY SUPPORT"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Watch for Vex attempting to sacrifice at the relay and help clear shielded enemies. Keep the active relay safe while the mote team rotates."
                                       Foreground="#B0B0B0"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>


                <!-- IMPORTANT MECHANICS -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="IMPORTANT MECHANICS"
                                   Foreground="#E00000"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>


                        <TextBlock Text="VOLTAIC MOTES"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Voltaic Motes are dropped by Vex Minotaurs. Collect the required number and deposit them into the active relay. Picking up a mote starts the Voltaic Overflow timer, so do not collect another while the debuff is active."
                                   Foreground="#B0B0B0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,15"/>


                        <TextBlock Text="ENLIGHTENED"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Depositing motes activates the relay and provides Enlightened. Use this buff to damage shielded Vex during the encounter."
                                   Foreground="#B0B0B0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,15"/>


                        <TextBlock Text="CONSECRATED MIND"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                        <TextBlock Text="The boss moves between the active relays. When it reaches a relay, the team must be ready to use the tether and expose its weak points for damage."
                                   Foreground="#B0B0B0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,15"/>


                        <TextBlock Text="VEX SACRIFICES"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Vex will attempt to sacrifice at the active relay. Stop them before they reach it. Successful sacrifices reduce the relay's integrity."
                                   Foreground="#B0B0B0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,15"/>


                        <TextBlock Text="TETHER"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                        <TextBlock Text="The tether source must be connected through the fireteam to the receiver. Coordinate positioning carefully because the tether can interrupt weapon and ability use."
                                   Foreground="#B0B0B0"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>


                <!-- QUICK REFERENCE -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="QUICK REFERENCE"
                                   Foreground="#E00000"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>


                        <TextBlock Text="• Kill Minotaurs → collect Voltaic Motes"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Deposit motes into the active relay"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Maintain Enlightened"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Stop Vex sacrifices"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Track the Consecrated Mind"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Have the relay ready before the boss arrives"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Coordinate the tether"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Repeat until the boss is defeated"
                                   Foreground="White"
                                   FontSize="14"/>

                    </StackPanel>

                </Border>


                <!-- CHALLENGE -->
                <Border Background="#161616"
                        BorderBrush="#E00000"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="CHALLENGE"
                                   Foreground="#E00000"
                                   FontSize="13"
                                   FontWeight="Bold"/>

                        <TextBlock Text="TO THE TOP"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="Complete the encounter while depositing motes into the relays in the required order without skipping ahead. Keep the team coordinated so each relay is fully charged before moving to the next stage."
                                   Foreground="#B0B0B0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <!-- COMMON MISTAKES -->
                <Border Background="#161616"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="COMMON MISTAKES"
                                   Foreground="#E00000"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>


                        <TextBlock Text="• Collecting another Voltaic Mote while Voltaic Overflow is active"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Losing track of the Consecrated Mind"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Allowing Vex to sacrifice at the relay"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Arriving at a relay before it is properly charged"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Running out of Enlightened during shielded Vex waves"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,7"/>

                        <TextBlock Text="• Poor tether positioning during the boss phase"
                                   Foreground="White"
                                   FontSize="14"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>