<Page x:Class="DaBoyzApp.Pages.GamingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="45,40,45,50">

                <!-- ================================================= -->
                <!-- HEADER                                            -->
                <!-- ================================================= -->

                <TextBlock Text="GAMING DATABASE"
                           Foreground="{StaticResource DaBoyzText}"
                           FontSize="32"
                           FontWeight="Bold"/>

                <TextBlock Text="Games, guides, builds, items, and everything in between."
                           Foreground="{StaticResource DaBoyzTextSecondary}"
                           FontSize="14"
                           Margin="0,5,0,0"/>


                <!-- RED ACCENT -->

                <Border Height="2"
                        Width="80"
                        Background="{StaticResource DaBoyzRed}"
                        HorizontalAlignment="Left"
                        Margin="0,18,0,28"/>


                <!-- ================================================= -->
                <!-- SEARCH                                             -->
                <!-- ================================================= -->

                <Grid Height="45"
                      Margin="0,0,0,20">

                    <Border Background="#161616"
                            BorderBrush="#292929"
                            BorderThickness="1"
                            CornerRadius="8">

                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontSize="13"
                                 Padding="15,0"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>

                    </Border>

                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Search games..."
                               Foreground="#666666"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="15,0"
                               IsHitTestVisible="False"/>

                </Grid>

                <!-- ================================================= -->
                <!-- GAME GRID                                          -->
                <!-- ================================================= -->

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- ================================================= -->
                    <!-- DESTINY 2                                        -->
                    <!-- ================================================= -->

                        <Button x:Name="Destiny2Button"
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="0,0,8,8"
                            Click="Destiny2_Click">

                        <Grid>

                            <StackPanel>

                                <Border Width="90"
                                        Height="90"
                                        CornerRadius="12"
                                        Background="#0D0D0D"
                                        BorderBrush="#292929"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left">

                                    <Image Source="/Assets/Games/destiny2.png"
                                           Width="70"
                                           Height="70"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock Text="DESTINY 2"
                                           Foreground="White"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Margin="0,18,0,3"/>

                                <TextBlock Text="FPS • MMO"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Builds, weapons, armor, raids, dungeons, and more."
                                           Foreground="{StaticResource DaBoyzTextSecondary}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>

                                <TextBlock Text="EXPLORE  →"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Margin="0,18,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Button>

                    <!-- ================================================= -->
                    <!-- MINECRAFT                                        -->
                    <!-- ================================================= -->

                        <Button x:Name="MinecraftButton"
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="0,0,8,8"
                            Click="Minecraft_Click">

                        <StackPanel>

                            <Border Width="90"
                                    Height="90"
                                    CornerRadius="12"
                                    Background="#0D0D0D"
                                    BorderBrush="#292929"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left">

                                <Image Source="/Assets/Games/minecraft.png"
                                       Width="70"
                                       Height="70"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock Text="MINECRAFT"
                                       Foreground="White"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Margin="0,18,0,3"/>

                            <TextBlock Text="SURVIVAL • SANDBOX"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Mods, builds, farms, mechanics, servers, and more."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="EXPLORE  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>


                    <!-- ================================================= -->
                    <!-- CALL OF DUTY                                     -->
                    <!-- ================================================= -->

                        <Button x:Name="CallofDutyButton"
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="0,0,8,8"
                            Click="CallofDuty_Click">

                        <StackPanel>

                            <Border Width="90"
                                    Height="90"
                                    CornerRadius="12"
                                    Background="#0D0D0D"
                                    BorderBrush="#292929"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left">

                                <Image Source="/Assets/Games/cod.png"
                                       Width="70"
                                       Height="70"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock Text="CALL OF DUTY"
                                       Foreground="White"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Margin="0,18,0,3"/>

                            <TextBlock Text="FPS"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Weapons, loadouts, multiplayer, Warzone, and more."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="EXPLORE  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>

                    <!-- ================================================= -->
                    <!-- ROCKET LEAGUE                                    -->
                    <!-- ================================================= -->

                        <Button x:Name="RocketLeagueButton"
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="0,0,8,8"
                            Click="RocketLeague_Click">

                        <StackPanel>

                            <Border Width="90"
                                    Height="90"
                                    CornerRadius="12"
                                    Background="#0D0D0D"
                                    BorderBrush="#292929"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left">

                                <Image Source="/Assets/Games/rl.png"
                                       Width="70"
                                       Height="70"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock Text="ROCKET LEAGUE"
                                       Foreground="White"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Margin="0,18,0,3"/>

                            <TextBlock Text="SPORTS • COMPETITIVE"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Mechanics, training, rotations, car setups, and more."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="EXPLORE  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>

                    <!-- ================================================= -->
                    <!-- HELLDIVERS 2                                     -->
                    <!-- ================================================= -->
    
                        <Button x:Name="HelldiversButton"
                            Grid.Row="3"
                            Grid.Column="0"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="0,0,8,8"
                            Click="Helldivers_Click">

                        <StackPanel>

                            <Border Width="90"
                                    Height="90"
                                    CornerRadius="12"
                                    Background="#0D0D0D"
                                    BorderBrush="#292929"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left">

                                <Image Source="/Assets/Games/helldivers2.png"
                                       Width="70"
                                       Height="70"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock Text="HELLDIVERS 2"
                                       Foreground="White"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Margin="0,18,0,3"/>

                            <TextBlock Text="CO-OP • SHOOTER"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Stratagems, weapons, armor, enemies, missions, and more."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="EXPLORE  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>

                    <!-- ================================================= -->
                    <!-- MARVEL RIVALS                                    -->
                    <!-- ================================================= -->

                        <Button x:Name="MarvelRivalsButton"
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="0,0,8,8"
                            Click="MarvelRivals_Click">

                        <StackPanel>

                            <Border Width="90"
                                    Height="90"
                                    CornerRadius="12"
                                    Background="#0D0D0D"
                                    BorderBrush="#292929"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left">

                                <Image Source="/Assets/Games/marvelrivals.png"
                                       Width="70"
                                       Height="70"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock Text="MARVEL RIVALS"
                                       Foreground="White"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Margin="0,18,0,3"/>

                            <TextBlock Text="HERO • SHOOTER"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Heroes, team compositions, abilities, maps, and more."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="EXPLORE  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>

                    <!-- ================================================= -->
                    <!-- RAINBOW SIX SIEGE                                -->
                    <!-- ================================================= -->

                        <Button x:Name="Rainbow6SiegeButton"
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="0,0,8,8"
                            Click="Rainbow6Siege_Click">

                        <StackPanel>

                            <Border Width="90"
                                    Height="90"
                                    CornerRadius="12"
                                    Background="#0D0D0D"
                                    BorderBrush="#292929"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left">
                            
                            <Image Source="/Assets/Games/r6.png"
                                   Width="70"
                                   Height="70"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock Text="RAINBOW SIX SIEGE"
                                       Foreground="White"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Margin="0,18,0,3"/>

                            <TextBlock Text="FPS • TACTICAL"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Operators, weapons, strategies, maps, and more."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="EXPLORE  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>
                        </StackPanel>
                    
                    </Button>


                    <!-- ================================================= -->
                    <!-- FIVEM                                             -->
                    <!-- ================================================= -->

                        <Button x:Name="FiveMButton"
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="0,0,8,8"
                            Click="FiveM_Click">

                        <StackPanel>

                            <Border Width="90"
                                    Height="90"
                                    CornerRadius="12"
                                    Background="#0D0D0D"
                                    BorderBrush="#292929"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left">

                                <Image Source="/Assets/Games/fivem.png"
                                       Width="70"
                                       Height="70"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock Text="FIVEM"
                                       Foreground="White"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Margin="0,18,0,3"/>

                            <TextBlock Text="GTA • RP"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Servers, scripts, resources, vehicles, and roleplay."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="EXPLORE  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>

                </Grid>


                <!-- ================================================= -->
                <!-- FOOTER                                            -->
                <!-- ================================================= -->

                <TextBlock Text="DA BOYZ • GAMING DATABASE"
                           Foreground="{StaticResource DaBoyzTextMuted}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,35,0,0"/>

                <TextBlock Text="Created by: KaroDevGroup"
                           Foreground="#666666"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>