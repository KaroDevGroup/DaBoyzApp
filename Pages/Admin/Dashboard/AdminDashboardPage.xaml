<Page x:Class="DaBoyzApp.Pages.AdminDashboardPage"
   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

<Grid Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="45,40,45,50">

            <!-- ================================================= -->
            <!-- HEADER                                            -->
            <!-- ================================================= -->

            <TextBlock Text="ADMIN DASHBOARD"
                       Foreground="{StaticResource DaBoyzText}"
                       FontSize="32"
                       FontWeight="Bold"/>

            <TextBlock Text="Da Boyz staff resources and administration."
                       Foreground="{StaticResource DaBoyzTextSecondary}"
                       FontSize="14"
                       Margin="0,5,0,0"/>

            <!-- RED ACCENT -->

            <Border Height="2"
                    Width="80"
                    Background="{StaticResource DaBoyzRed}"
                    HorizontalAlignment="Left"
                    Margin="0,18,0,30"/>


            <!-- ================================================= -->
            <!-- WELCOME                                            -->
            <!-- ================================================= -->

            <Border Style="{StaticResource DashboardCardStyle}"
                    Margin="0,0,0,30">

                <StackPanel>

                    <TextBlock Text="WELCOME BACK"
                               Foreground="{StaticResource DaBoyzRed}"
                               FontSize="11"
                               FontWeight="Bold"/>

                    <TextBlock Text="Staff Control Center"
                               Foreground="{StaticResource DaBoyzText}"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,5,0,3"/>

                    <TextBlock Text="Access the resources you need to manage and moderate the Da Boyz community."
                               Foreground="{StaticResource DaBoyzTextSecondary}"
                               FontSize="13"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- STAFF RESOURCES                                   -->
            <!-- ================================================= -->

            <TextBlock Text="STAFF RESOURCES"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,0,0,15"/>


            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- PUNISHMENT SLATE                                 -->
                <!-- ================================================= -->

                <Button x:Name="PunishmentSlateButton"
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource AdminDashboardButtonStyle}"
                        Margin="0,0,8,8"
                        Click="PunishmentSlate_Click">

                    <StackPanel>

                        <TextBlock Text="⚖"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="30"
                                   FontWeight="Bold"/>

                        <TextBlock Text="PUNISHMENT SLATE"
                                   Foreground="{StaticResource DaBoyzText}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,10,0,3"/>

                        <TextBlock Text="View punishment guidelines, consequences, and moderation procedures."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="VIEW SLATE  →"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,18,0,0"/>

                    </StackPanel>

                </Button>


                <!-- ================================================= -->
                <!-- RULES                                             -->
                <!-- ================================================= -->

                <Button x:Name="RulesButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource AdminDashboardButtonStyle}"
                        Margin="8,0,0,8"
                        Click="Rules_Click">

                    <StackPanel>

                        <TextBlock Text="◆"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="26"
                                   FontWeight="Bold"/>

                        <TextBlock Text="RULES"
                                   Foreground="{StaticResource DaBoyzText}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,10,0,3"/>

                        <TextBlock Text="View server rules, staff guidelines, and community standards."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="VIEW RULES  →"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,18,0,0"/>

                    </StackPanel>

                </Button>


                <!-- ================================================= -->
                <!-- DISCORD COMMANDS                                 -->
                <!-- ================================================= -->

                <Button x:Name="DiscordCommandsButton"
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource AdminDashboardButtonStyle}"
                        Margin="0,8,8,0"
                        Click="DiscordCommands_Click">

                    <StackPanel>

                        <TextBlock Text="⌘"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="30"
                                   FontWeight="Bold"/>

                        <TextBlock Text="DISCORD COMMANDS"
                                   Foreground="{StaticResource DaBoyzText}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,10,0,3"/>

                        <TextBlock Text="View moderation, utility, and staff Discord commands."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="VIEW COMMANDS  →"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,18,0,0"/>

                    </StackPanel>

                </Button>


                <!-- ================================================= -->
                <!-- STAFF MEMBERS                                    -->
                <!-- ================================================= -->

                <Button x:Name="StaffMembersButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource AdminDashboardButtonStyle}"
                        Margin="8,8,0,0"
                        Click="StaffMembers_Click">

                    <StackPanel>

                        <TextBlock Text="♟"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="30"
                                   FontWeight="Bold"/>

                        <TextBlock Text="STAFF MEMBERS"
                                   Foreground="{StaticResource DaBoyzText}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,10,0,3"/>

                        <TextBlock Text="View the current Da Boyz staff team and their positions."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="VIEW STAFF  →"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,18,0,0"/>

                    </StackPanel>

                </Button>

            </Grid>


            <!-- ================================================= -->
            <!-- FOOTER                                            -->
            <!-- ================================================= -->

            <StackPanel HorizontalAlignment="Center"
                        Margin="0,35,0,0">

                <TextBlock Text="DA BOYZ • STAFF CONTROL CENTER"
                           Foreground="{StaticResource DaBoyzTextMuted}"
                           FontSize="11"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Created by: KaroDevGroup"
                           Foreground="#666666"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </StackPanel>

    </ScrollViewer>

</Grid>

</Page>