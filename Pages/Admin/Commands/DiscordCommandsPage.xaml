<Page x:Class="DaBoyzApp.Pages.DiscordCommandsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="45,40,45,50">

                <!-- ================================================= -->
                <!-- HEADER                                            -->
                <!-- ================================================= -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="DISCORD COMMANDS"
                                   Foreground="{StaticResource DaBoyzText}"
                                   FontSize="32"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Staff commands used to manage and moderate the Da Boyz Discord server."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="14"
                                   Margin="0,5,0,0"/>

                    </StackPanel>


                    <!-- BACK BUTTON -->

                    <Button Grid.Column="1"
                            Content="BACK TO ADMIN DASHBOARD"
                            Width="220"
                            Height="40"
                            Margin="30,0,0,0"
                            VerticalAlignment="Center"
                            Background="#161616"
                            Foreground="{StaticResource DaBoyzTextSecondary}"
                            BorderBrush="{StaticResource DaBoyzBorder}"
                            BorderThickness="1"
                            FontSize="11"
                            Padding="18,10"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="BackButton_Click"/>

                </Grid>


                <!-- RED ACCENT -->

                <Border Height="2"
                        Width="80"
                        Background="{StaticResource DaBoyzRed}"
                        HorizontalAlignment="Left"
                        Margin="0,18,0,30"/>


                <!-- ================================================= -->
                <!-- IMPORTANT DISCLAIMER                              -->
                <!-- ================================================= -->

                <Border Style="{StaticResource DashboardCardStyle}"
                        Margin="0,0,0,30">

                    <StackPanel>

                        <TextBlock Text="IMPORTANT"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="ALL COMMANDS GO THROUGH KARODEVGROUP BOT"
                                   Foreground="{StaticResource DaBoyzText}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Margin="0,6,0,4"/>

                        <TextBlock Text="These commands are intended to be executed through KaroDevGroup. Do not attempt to manually replicate or bypass KaroDevGroup's moderation systems."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- GENERAL COMMANDS                                  -->
                <!-- ================================================= -->

                <TextBlock Text="GENERAL COMMANDS"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,15"/>


                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- VERSION -->

                    <Border Grid.Column="0"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="0,0,8,8">

                        <StackPanel>

                            <WrapPanel VerticalAlignment="Center">

                                <TextBlock Text="/version"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                                <!-- TRIAL STAFF -->

                                <Border Background="#0BF4FC"
                                        CornerRadius="4"
                                        Margin="10,0,4,0"
                                        Padding="7,3"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="TRIAL STAFF"
                                               Foreground="#080808"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <!-- STAFF -->

                                <Border Background="#AF95E4"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="STAFF"
                                               Foreground="#080808"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <!-- SENIOR STAFF -->

                                <Border Background="#5B03C7"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="SENIOR STAFF"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <!-- MANAGEMENT -->

                                <Border Background="#e95505"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="MANAGEMENT"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <!-- OWNER -->

                                <Border Background="#E00000"
                                        CornerRadius="4"
                                        Margin="0"
                                        Padding="7,3"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="OWNER"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                            </WrapPanel>

                            <TextBlock Text="/version"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Margin="0,8,0,6"/>

                            <TextBlock Text="Displays the current version of the Da Boyz Discord bot."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <!-- DOWNLOAD -->

                    <Border Grid.Column="1"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="8,0,0,8">

                        <StackPanel>

                            <WrapPanel VerticalAlignment="Center">

                                <TextBlock Text="/download"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                                <Border Background="#0BF4FC"
                                        CornerRadius="4"
                                        Margin="10,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="TRIAL STAFF"
                                               Foreground="#080808"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#AF95E4"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="STAFF"
                                               Foreground="#080808"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#5B03C7"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="SENIOR STAFF"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#e95505"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="MANAGEMENT"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#E00000"
                                        CornerRadius="4"
                                        Padding="7,3">

                                    <TextBlock Text="OWNER"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                            </WrapPanel>

                            <TextBlock Text="/download"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Margin="0,8,0,6"/>

                            <TextBlock Text="Provides the current DaBoyzApp download or installation information."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- VOICE COMMANDS                                    -->
                <!-- ================================================= -->

                <TextBlock Text="VOICE COMMANDS"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,35,0,15"/>


                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- JOIN CALL -->

                    <Border Grid.Column="0"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="0,0,8,8">

                        <StackPanel>

                            <WrapPanel VerticalAlignment="Center">

                                <TextBlock Text="/joincall"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                                <Border Background="#0BF4FC"
                                        CornerRadius="4"
                                        Margin="10,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="TRIAL STAFF"
                                               Foreground="#080808"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#AF95E4"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="STAFF"
                                               Foreground="#080808"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#5B03C7"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="SENIOR STAFF"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#e95505"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="MANAGEMENT"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#E00000"
                                        CornerRadius="4"
                                        Padding="7,3">

                                    <TextBlock Text="OWNER"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                            </WrapPanel>

                            <TextBlock Text="/joincall"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Margin="0,8,0,6"/>

                            <TextBlock Text="Joins the specified Discord voice channel."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- CHANNEL COMMANDS                                  -->
                <!-- ================================================= -->

                <TextBlock Text="CHANNEL COMMANDS"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,35,0,15"/>


                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- LOCK -->

                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="0,0,8,8">

                        <StackPanel>

                            <WrapPanel>

                                <TextBlock Text="/lock"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <Border Background="#5B03C7"
                                        CornerRadius="4"
                                        Margin="10,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="SENIOR STAFF"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#e95505"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="MANAGEMENT"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#E00000"
                                        CornerRadius="4"
                                        Padding="7,3">

                                    <TextBlock Text="OWNER"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                            </WrapPanel>

                            <TextBlock Text="/lock"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Margin="0,8,0,6"/>

                            <TextBlock Text="Locks a channel to prevent members from sending messages."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <!-- UNLOCK -->

                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="8,0,0,8">

                        <StackPanel>

                            <WrapPanel>

                                <TextBlock Text="/unlock"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <Border Background="#5B03C7"
                                        CornerRadius="4"
                                        Margin="10,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="SENIOR STAFF"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#e95505"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="MANAGEMENT"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#E00000"
                                        CornerRadius="4"
                                        Padding="7,3">

                                    <TextBlock Text="OWNER"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                            </WrapPanel>

                            <TextBlock Text="/unlock"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Margin="0,8,0,6"/>

                            <TextBlock Text="Removes a channel lock and allows members to send messages again."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <!-- CLEAR -->

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="0,8,8,0">

                        <StackPanel>

                            <WrapPanel>

                                <TextBlock Text="/clear"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <Border Background="#AF95E4"
                                        CornerRadius="4"
                                        Margin="10,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="STAFF"
                                               Foreground="#080808"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#5B03C7"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="SENIOR STAFF"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#e95505"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="MANAGEMENT"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#E00000"
                                        CornerRadius="4"
                                        Padding="7,3">

                                    <TextBlock Text="OWNER"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                            </WrapPanel>

                            <TextBlock Text="/clear [number_of_messages]"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Margin="0,8,0,6"/>

                            <TextBlock Text="Deletes a specified number of messages from a channel."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <!-- SLOWMODE -->

                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="8,8,0,0">

                        <StackPanel>

                            <WrapPanel>

                                <TextBlock Text="/slowmode"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <Border Background="#AF95E4"
                                        CornerRadius="4"
                                        Margin="10,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="STAFF"
                                               Foreground="#080808"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#5B03C7"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="SENIOR STAFF"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#e95505"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="MANAGEMENT"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#E00000"
                                        CornerRadius="4"
                                        Padding="7,3">

                                    <TextBlock Text="OWNER"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                            </WrapPanel>

                            <TextBlock Text="/slowmode [time]"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Margin="0,8,0,6"/>

                            <TextBlock Text="Sets or changes the slowmode delay for a channel."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- MODERATION COMMANDS                               -->
                <!-- ================================================= -->

                <TextBlock Text="MODERATION COMMANDS"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,35,0,15"/>


                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- TIMEOUT -->

                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="0,0,8,8">

                        <StackPanel>

                            <WrapPanel>

                                <TextBlock Text="/timeout"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <Border Background="#0BF4FC"
                                        CornerRadius="4"
                                        Margin="10,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="TRIAL STAFF"
                                               Foreground="#080808"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#AF95E4"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="STAFF"
                                               Foreground="#080808"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#5B03C7"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="SENIOR STAFF"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#e95505"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="MANAGEMENT"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#E00000"
                                        CornerRadius="4"
                                        Padding="7,3">

                                    <TextBlock Text="OWNER"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                            </WrapPanel>

                            <TextBlock Text="/timeout [user] [duration] [reason]"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Margin="0,8,0,6"/>

                            <TextBlock Text="Temporarily restricts a user from interacting in the Discord server."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <!-- KICK -->

                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="8,0,0,8">

                        <StackPanel>

                            <WrapPanel>

                                <TextBlock Text="/kick"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <Border Background="#AF95E4"
                                        CornerRadius="4"
                                        Margin="10,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="STAFF"
                                               Foreground="#080808"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#5B03C7"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="SENIOR STAFF"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#e95505"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="MANAGEMENT"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#E00000"
                                        CornerRadius="4"
                                        Padding="7,3">

                                    <TextBlock Text="OWNER"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                            </WrapPanel>

                            <TextBlock Text="/kick [user] [reason]"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Margin="0,8,0,6"/>

                            <TextBlock Text="Kicks a user from the Discord server."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <!-- WARN -->

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="0,8,8,8">

                        <StackPanel>

                            <WrapPanel>

                                <TextBlock Text="/warn"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <Border Background="#0BF4FC"
                                        CornerRadius="4"
                                        Margin="10,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="TRIAL STAFF"
                                               Foreground="#080808"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#AF95E4"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="STAFF"
                                               Foreground="#080808"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#5B03C7"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="SENIOR STAFF"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#e95505"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Padding="7,3">

                                    <TextBlock Text="MANAGEMENT"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <Border Background="#E00000"
                                        CornerRadius="4"
                                        Padding="7,3">

                                    <TextBlock Text="OWNER"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                            </WrapPanel>

                            <TextBlock Text="/warn [user] [reason]"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Margin="0,8,0,6"/>

                            <TextBlock Text="Warns a user and records the warning."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <!-- WARNINGS -->

                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="8,8,0,8">

                        <StackPanel>

                            <WrapPanel>

                                <TextBlock Text="/warnings"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <Border Background="#0BF4FC"
