<Page x:Class="DaBoyzApp.Pages.DiscordCommandsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="45,40,45,50">

                <!-- ================================================= -->
                <!-- HEADER                                            -->
                <!-- ================================================= -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="DISCORD COMMANDS"
                                   Foreground="{StaticResource DaBoyzText}"
                                   FontSize="32"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Staff commands used to manage and moderate the Da Boyz Discord server."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="14"
                                   Margin="0,5,0,0"/>

                    </StackPanel>


                    <!-- BACK BUTTON -->

                    <Button Grid.Column="1"
                            Content="BACK TO ADMIN DASHBOARD"
                            Width="220"
                            Height="40"
                            Margin="30,0,0,0"
                            VerticalAlignment="Center"
                            Background="#161616"
                            Foreground="{StaticResource DaBoyzTextSecondary}"
                            BorderBrush="{StaticResource DaBoyzBorder}"
                            BorderThickness="1"
                            FontSize="11"
                            Padding="18,10"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="BackButton_Click"/>

                </Grid>


                <!-- RED ACCENT -->

                <Border Height="2"
                        Width="80"
                        Background="{StaticResource DaBoyzRed}"
                        HorizontalAlignment="Left"
                        Margin="0,18,0,30"/>


                <!-- ================================================= -->
                <!-- IMPORTANT DISCLAIMER                              -->
                <!-- ================================================= -->

                <Border Style="{StaticResource DashboardCardStyle}"
                        Margin="0,0,0,30">

                    <StackPanel>

                        <TextBlock Text="IMPORTANT"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="ALL COMMANDS MUST GO THROUGH PROBOT"
                                   Foreground="{StaticResource DaBoyzText}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Margin="0,6,0,4"/>

                        <TextBlock Text="These commands are intended to be executed through ProBot. Do not attempt to manually replicate or bypass ProBot's moderation systems."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- MODERATION COMMANDS                               -->
                <!-- ================================================= -->

                <TextBlock Text="MODERATION COMMANDS"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,15"/>


                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- WARN -->

                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="0,0,8,8">

                        <StackPanel>

                            <TextBlock Text="/warn"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Text="/warn [user] [reason]"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Margin="0,8,0,6"/>

                            <TextBlock Text="Warns a user and records the warning."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <!-- REMOVE WARNING -->

                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="8,0,0,8">

                        <StackPanel>

                            <TextBlock Text="/warn_remove"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Text="/warn_remove [input]"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Margin="0,8,0,6"/>

                            <TextBlock Text="Removes a warning from a user's warning record."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <!-- VIEW WARNINGS -->

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="0,8,8,8">

                        <StackPanel>

                            <TextBlock Text="/warnings"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Text="/warnings [user] [page]"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Margin="0,8,0,6"/>

                            <TextBlock Text="Displays a user's recorded warnings."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <!-- KICK -->

                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="8,8,0,8">

                        <StackPanel>

                            <TextBlock Text="/kick"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Text="/kick [user] [reason]"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Margin="0,8,0,6"/>

                            <TextBlock Text="Kicks a user from the Discord server."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <!-- BAN -->

                    <Border Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="0,8,8,0">

                        <StackPanel>

                            <TextBlock Text="/ban"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Text="/ban [user] [time] [reason] [bulk]"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Margin="0,8,0,6"/>

                            <TextBlock Text="Bans a user from the Discord server."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <!-- UNBAN -->

                    <Border Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="8,8,0,0">

                        <StackPanel>

                            <TextBlock Text="/unban"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Text="/unban [input]"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Margin="0,8,0,6"/>

                            <TextBlock Text="Removes a ban from a user."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- CHANNEL COMMANDS                                  -->
                <!-- ================================================= -->

                <TextBlock Text="CHANNEL COMMANDS"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,35,0,15"/>


                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- LOCK -->

                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="0,0,8,8">

                        <StackPanel>

                            <TextBlock Text="/lock"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Text="/lock [channel] [reason]"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Margin="0,8,0,6"/>

                            <TextBlock Text="Locks a channel to prevent members from sending messages."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <!-- UNLOCK -->

                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="8,0,0,8">

                        <StackPanel>

                            <TextBlock Text="/unlock"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Text="/unlock [channel]"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Margin="0,8,0,6"/>

                            <TextBlock Text="Removes a channel lock."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <!-- CLEAR -->

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="0,8,8,0">

                        <StackPanel>

                            <TextBlock Text="/clear"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Text="/clear [number_of_messages]"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Margin="0,8,0,6"/>

                            <TextBlock Text="Deletes a specified number of messages from a channel."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- FOOTER                                            -->
                <!-- ================================================= -->

                <StackPanel HorizontalAlignment="Center"
                            Margin="0,40,0,0">

                    <TextBlock Text="DA BOYZ • DISCORD COMMANDS"
                               Foreground="{StaticResource DaBoyzTextMuted}"
                               FontSize="11"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Created by: KaroDevGroup"
                               Foreground="#666666"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>