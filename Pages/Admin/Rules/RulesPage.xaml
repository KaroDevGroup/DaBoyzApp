<Page x:Class="DaBoyzApp.Pages.RulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="45,40,45,50">

                <!-- ================================================= -->
                <!-- HEADER                                            -->
                <!-- ================================================= -->

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel>

                        <TextBlock Text="SERVER RULES"
                                   Foreground="{StaticResource DaBoyzText}"
                                   FontSize="32"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Da Boyz community rules and standards."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="14"
                                   Margin="0,5,0,0"/>

                        <Border Height="2"
                                Width="80"
                                Background="{StaticResource DaBoyzRed}"
                                HorizontalAlignment="Left"
                                Margin="0,18,0,0"/>

                    </StackPanel>


                    <!-- BACK BUTTON -->

                    <Button Grid.Column="1"
                            Content="BACK TO ADMIN DASHBOARD" 
                            Width="220"
                            Height="40"
                            Click="BackButton_Click"
                            Background="#161616"
                            Foreground="{StaticResource DaBoyzTextSecondary}"
                            BorderBrush="{StaticResource DaBoyzBorder}"
                            BorderThickness="1"
                            Padding="18,10"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Margin="30,0,0,0"
                            Cursor="Hand"
                            VerticalAlignment="Center"/>

                </Grid>


                <!-- ================================================= -->
                <!-- INTRODUCTION                                      -->
                <!-- ================================================= -->

                <Border Style="{StaticResource DashboardCardStyle}"
                        Margin="0,30,0,25">

                    <StackPanel>

                        <TextBlock Text="COMMUNITY STANDARDS"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="These rules apply to everyone in the Da Boyz community."
                                   Foreground="{StaticResource DaBoyzText}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,5,0,3"/>

                        <TextBlock Text="Staff should use these guidelines when handling reports, moderation situations, and other community issues."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- RULES                                              -->
                <!-- ================================================= -->

                <TextBlock Text="RULES"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,15"/>


                <!-- ================================================= -->
                <!-- RULE #1                                            -->
                <!-- ================================================= -->

                <Border Style="{StaticResource DashboardCardStyle}"
                        Margin="0,0,0,12">

                    <StackPanel>

                        <TextBlock Text="RULE #1"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Don't be a dick."
                                   Foreground="{StaticResource DaBoyzText}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,5,0,8"/>

                        <TextBlock Text="Treat people with respect. No harassment, discrimination, or witch hunting is tolerated. Treat others how you want to be treated."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- RULE #2                                            -->
                <!-- ================================================= -->

                <Border Style="{StaticResource DashboardCardStyle}"
                        Margin="0,0,0,12">

                    <StackPanel>

                        <TextBlock Text="RULE #2"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="No Spam/Self Promo."
                                   Foreground="{StaticResource DaBoyzText}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,5,0,8"/>

                        <TextBlock Text="No spam, server invites, or promotions without approval from staff. If you are a streamer, you are exempt from promotions."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- RULE #3                                            -->
                <!-- ================================================= -->

                <Border Style="{StaticResource DashboardCardStyle}"
                        Margin="0,0,0,12">

                    <StackPanel>

                        <TextBlock Text="RULE #3"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Respect Privacy."
                                   Foreground="{StaticResource DaBoyzText}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,5,0,8"/>

                        <TextBlock Text="Do not DM or add other members without their permission. Do not share personal information that is not yours with other people."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- RULE #4                                            -->
                <!-- ================================================= -->

                <Border Style="{StaticResource DashboardCardStyle}"
                        Margin="0,0,0,12">

                    <StackPanel>

                        <TextBlock Text="RULE #4"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Follow channel rules."
                                   Foreground="{StaticResource DaBoyzText}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,5,0,8"/>

                        <TextBlock Text="Use channels for their intended purposes. (Ex. Do not intentionally post memes in the music channel.)"
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- RULE #5                                            -->
                <!-- ================================================= -->

                <Border Style="{StaticResource DashboardCardStyle}"
                        Margin="0,0,0,12">

                    <StackPanel>

                        <TextBlock Text="RULE #5"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="No bypassing restrictions."
                                   Foreground="{StaticResource DaBoyzText}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,5,0,8"/>

                        <TextBlock Text="Do not use modified clients (e.g., Vencord) or any exploits to access/view locked channels or hidden content."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- RULE #6                                            -->
                <!-- ================================================= -->

                <Border Style="{StaticResource DashboardCardStyle}"
                        Margin="0,0,0,12">

                    <StackPanel>

                        <TextBlock Text="RULE #6"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Listen to staff."
                                   Foreground="{StaticResource DaBoyzText}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,5,0,8"/>

                        <TextBlock Text="Staff decisions are final and not to be spoken of unless with the Owner."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- STAFF NOTE                                        -->
                <!-- ================================================= -->

                <Border Style="{StaticResource DashboardCardStyle}"
                        Margin="0,18,0,0">

                    <StackPanel>

                        <TextBlock Text="STAFF NOTE"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Use the Punishment Slate alongside these rules when determining appropriate consequences."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- FOOTER                                            -->
                <!-- ================================================= -->

                <StackPanel HorizontalAlignment="Center"
                            Margin="0,35,0,0">

                    <TextBlock Text="DA BOYZ • SERVER RULES"
                               Foreground="{StaticResource DaBoyzTextMuted}"
                               FontSize="11"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Created by: KaroDevGroup"
                               Foreground="#666666"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>