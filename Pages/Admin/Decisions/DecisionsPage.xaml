<!-- Josh Karo -->

<Page x:Class="DaBoyzApp.Pages.DecisionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="45,40,45,50">

                <!-- ================================================= -->
                <!-- HEADER                                            -->
                <!-- ================================================= -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="DECISIONS"
                                Foreground="{StaticResource DaBoyzText}"
                                FontSize="32"
                                FontWeight="Bold"/>

                        <TextBlock Text="Issue moderation actions through the Da Boyz Discord bot."
                                Foreground="{StaticResource DaBoyzTextSecondary}"
                                FontSize="14"
                                Margin="0,5,0,0"/>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="BACK TO ADMIN DASHBOARD"
                            Width="220"
                            Height="40"
                            Margin="30,0,0,0"
                            VerticalAlignment="Center"
                            Background="#161616"
                            Foreground="{StaticResource DaBoyzTextSecondary}"
                            BorderBrush="{StaticResource DaBoyzBorder}"
                            BorderThickness="1"
                            FontSize="11"
                            Padding="18,10"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="BackButton_Click"/>
                </Grid>

                <Border Height="2"
                        Width="80"
                        Background="{StaticResource DaBoyzRed}"
                        HorizontalAlignment="Left"
                        Margin="0,18,0,30"/>
                    
                <!-- ================================================= -->
                <!-- MODERATION ACTIONS                                -->
                <!-- ================================================= -->

                <TextBlock Text="MODERATION ACTIONS"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,15"/>


                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- WARN -->

                    <Button x:Name="WarnButton"
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="0,0,8,8"
                            Click="Warn_Click">

                        <StackPanel>

                            <TextBlock Text="⚠"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="28"
                                       FontWeight="Bold"/>

                            <TextBlock Text="WARN MEMBER"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,10,0,3"/>

                            <TextBlock Text="Issue a warning to a Discord member."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="OPEN  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>


                    <!-- TIMEOUT -->

                    <Button x:Name="TimeoutButton"
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="8,0,0,8"
                            Click="Timeout_Click">

                        <StackPanel>

                            <TextBlock Text="◷"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="28"
                                       FontWeight="Bold"/>

                            <TextBlock Text="TIMEOUT MEMBER"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,10,0,3"/>

                            <TextBlock Text="Temporarily restrict a Discord member."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="OPEN  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>


                    <!-- KICK -->

                    <Button x:Name="KickButton"
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="0,8,8,8"
                            Click="Kick_Click">

                        <StackPanel>

                            <TextBlock Text="⇥"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="28"
                                       FontWeight="Bold"/>

                            <TextBlock Text="KICK MEMBER"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,10,0,3"/>

                            <TextBlock Text="Remove a member from the Discord server."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="OPEN  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>


                    <!-- BAN -->

                    <Button x:Name="BanButton"
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="8,8,0,8"
                            Click="Ban_Click">

                        <StackPanel>

                            <TextBlock Text="⊘"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="28"
                                       FontWeight="Bold"/>

                            <TextBlock Text="BAN MEMBER"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,10,0,3"/>

                            <TextBlock Text="Ban a member from the Discord server."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="OPEN  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>


                    <!-- UNBAN -->

                    <Button x:Name="UnbanButton"
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="0,8,8,8"
                            Click="Unban_Click">

                        <StackPanel>

                            <TextBlock Text="↺"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="28"
                                       FontWeight="Bold"/>

                            <TextBlock Text="UNBAN MEMBER"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,10,0,3"/>

                            <TextBlock Text="Remove a ban from a Discord user."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="OPEN  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>


                    <!-- CLEAR -->

                    <Button x:Name="ClearButton"
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="8,8,0,8"
                            Click="Clear_Click">

                        <StackPanel>

                            <TextBlock Text="⌫"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="28"
                                       FontWeight="Bold"/>

                            <TextBlock Text="CLEAR MESSAGES"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,10,0,3"/>

                            <TextBlock Text="Remove messages from a Discord channel."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="OPEN  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>


                    <!-- LOCK -->

                    <Button x:Name="LockButton"
                            Grid.Row="3"
                            Grid.Column="0"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="0,8,8,0"
                            Click="Lock_Click">

                        <StackPanel>

                            <TextBlock Text="🔒"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="24"/>

                            <TextBlock Text="LOCK CHANNEL"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,10,0,3"/>

                            <TextBlock Text="Prevent members from sending messages in a channel."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="OPEN  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>


                    <!-- UNLOCK -->

                    <Button x:Name="UnlockButton"
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="8,8,0,0"
                            Click="Unlock_Click">

                        <StackPanel>

                            <TextBlock Text="🔓"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="24"/>

                            <TextBlock Text="UNLOCK CHANNEL"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,10,0,3"/>

                            <TextBlock Text="Restore messaging access in a Discord channel."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="OPEN  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>

                </Grid>


                <!-- ================================================= -->
                <!-- FOOTER                                            -->
                <!-- ================================================= -->

                <TextBlock Text="DA BOYZ • ADMIN DECISIONS"
                           Foreground="{StaticResource DaBoyzTextMuted}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,35,0,0"/>

                <TextBlock Text="Created by: KaroDevGroup"
                           Foreground="#666666"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>