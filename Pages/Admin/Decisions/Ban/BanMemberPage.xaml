<Page x:Class="DaBoyzApp.Pages.BanMemberPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">

        <Grid>

            <!-- ================================================= -->
            <!-- HEADER                                            -->
            <!-- ================================================= -->

            <StackPanel Margin="45,40,45,50">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="BAN MEMBER"
                                   Foreground="{StaticResource DaBoyzText}"
                                   FontSize="32"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Ban a Discord member from the server through DaBoyzApp."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="14"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="BACK TO DECISIONS"
                            Width="180"
                            Height="40"
                            Margin="30,0,0,0"
                            VerticalAlignment="Center"
                            Background="#161616"
                            Foreground="{StaticResource DaBoyzTextSecondary}"
                            BorderBrush="{StaticResource DaBoyzBorder}"
                            BorderThickness="1"
                            FontSize="11"
                            Padding="18,10"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="BackButton_Click"/>

                </Grid>

                <Border Height="2"
                        Width="80"
                        Background="{StaticResource DaBoyzRed}"
                        HorizontalAlignment="Left"
                        Margin="0,18,0,0"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- CENTER BAN CARD                                   -->
            <!-- ================================================= -->

            <Border Width="520"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ClipToBounds="True">

                <Grid>

                    <!-- DARK BASE -->

                    <Border Background="#161616"
                            CornerRadius="16"/>

                    <!-- GRUNGE FORM BACKGROUND -->

                    <Border Background="{StaticResource FormCardBackgroundImage}"
                            CornerRadius="16"
                            Opacity="0.40"/>

                    <!-- READABILITY OVERLAY -->

                    <Border Background="#50000000"
                            CornerRadius="16"/>

                    <!-- CONTENT -->

                    <StackPanel Margin="40">

                        <StackPanel HorizontalAlignment="Center"
                                    Margin="0,0,0,30">

                            <TextBlock Text="DA BOYZ"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="MODERATION"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>

                        </StackPanel>


                        <TextBlock Text="Ban a member."
                                   Foreground="{StaticResource DaBoyzText}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Enter the Discord member ID and reason."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,6,0,30"/>


                        <!-- MEMBER ID -->

                        <TextBlock Text="MEMBER DISCORD ID"
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>

                        <Border Background="#111111"
                                BorderBrush="#292929"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="45"
                                Margin="0,0,0,18">

                            <TextBox x:Name="MemberIdBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     FontSize="13"
                                     Padding="14,0"
                                     VerticalContentAlignment="Center"/>

                        </Border>


                        <!-- REASON -->

                        <TextBlock Text="REASON"
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>

                        <Border Background="#111111"
                                BorderBrush="#292929"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,22">

                            <TextBox x:Name="ReasonBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     FontSize="13"
                                     Padding="14,12"
                                     MinHeight="110"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>

                        </Border>


                        <!-- SUBMIT -->

                        <Button x:Name="BanButton"
                                Content="BAN MEMBER"
                                Height="45"
                                Background="{StaticResource DaBoyzRed}"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BanButton_Click"/>


                        <!-- STATUS -->

                        <TextBlock x:Name="StatusText"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,15,0,0"/>


                        <!-- FOOTER -->

                        <TextBlock Text="AUTHORIZED SENIOR STAFF ONLY"
                                   Foreground="{StaticResource DaBoyzTextMuted}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,25,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Page>