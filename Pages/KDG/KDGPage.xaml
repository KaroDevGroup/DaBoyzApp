<Page x:Class="DaBoyzApp.Pages.KDGPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>

        <!-- ========================================================= -->
        <!-- DASHBOARD CARD HOVER STYLE                                -->
        <!-- ========================================================= -->

        <Style x:Key="DashboardButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#161616"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#292929"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="24">

                            <ContentPresenter/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Card"
                                        Property="Background"
                                        Value="#1E1E1E"/>

                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="#E00000"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Card"
                                        Property="Background"
                                        Value="#252525"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Page.Resources>


    <!-- ============================================================= -->
    <!-- ROOT                                                          -->
    <!-- ============================================================= -->

    <Grid Background="Transparent">

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="45,40,45,40">


                <!-- ================================================= -->
                <!-- HEADER                                            -->
                <!-- ================================================= -->

                <StackPanel>

                    <TextBlock Text="KaroDevGroup"
                               Foreground="{StaticResource DaBoyzTextSecondary}"
                               FontSize="14"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="GITHUB PROJECTS"
                               Foreground="{StaticResource DaBoyzText}"
                               FontSize="42"
                               FontWeight="Bold"
                               Margin="0,2,0,0"/>

                    <TextBlock Text="Find all KaroDevGroup Projects here."
                               Foreground="{StaticResource DaBoyzTextSecondary}"
                               FontSize="14"
                               Margin="0,5,0,0"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- ACCENT                                            -->
                <!-- ================================================= -->

                <Border Height="2"
                        Width="80"
                        Background="{StaticResource DaBoyzRed}"
                        HorizontalAlignment="Left"
                        Margin="0,18,0,30"/>


                <!-- ================================================= -->
                <!-- QUICK ACCESS                                      -->
                <!-- ================================================= -->

                <TextBlock Text="GITHUB PROJECTS"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,15"/>


                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- KDG BOT -->

                    <Button x:Name="KDGBotButton"
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="0,0,8,8"
                            Click="KDGBot_Click">

                        <StackPanel>

                            <TextBlock Text="◆"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="26"
                                       FontWeight="Bold"/>

                            <TextBlock Text="DaBoyzBot"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,10,0,3"/>

                            <TextBlock Text="A discord bot framework developed for the DaBoyz."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="EXPLORE  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>


                    <!-- KDG APP -->

                    <Button x:Name="KDGAppButton"
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="8,0,0,8"
                            Click="KDGApp_Click">

                        <StackPanel>

                            <TextBlock Text="◆"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="30"
                                       FontWeight="Bold"/>

                            <TextBlock Text="DaBoyzApp"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,10,0,3"/>

                            <TextBlock Text="Windows application built for the DaBoyz."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="EXPLORE  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>


                    <!-- KDG TEXTURE -->

                    <Button x:Name="KDGTextureButton"
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="0,8,8,0"
                            Click="KDGTexture_Click">

                        <StackPanel>

                            <TextBlock Text="◆"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="30"
                                       FontWeight="Bold"/>

                            <TextBlock Text="KDG Texture"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,10,0,3"/>

                            <TextBlock Text="FiveM script for texture reloading via a command."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="EXPLORE  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>


                    <!-- KDG POSTAL -->

                    <Button x:Name="KDGPostalButton"
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource AdminDashboardButtonStyle}"
                            Margin="8,8,0,0"
                            Click="KDGPostal_Click">

                        <StackPanel>

                            <TextBlock Text="◆"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="30"/>

                            <TextBlock Text="KDG Postal"
                                       Foreground="{StaticResource DaBoyzText}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,10,0,3"/>

                            <TextBlock Text="FiveM script for waypoint pinging via command."
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="EXPLORE  →"
                                       Foreground="{StaticResource DaBoyzRed}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,18,0,0"/>

                        </StackPanel>

                    </Button>

                </Grid>


                <!-- ================================================= -->
                <!-- COMMUNITY OVERVIEW                                -->
                <!-- ================================================= -->

                <TextBlock Text="PROJECT VERSIONS"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,35,0,15"/>


                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- KDG BOT -->

                    <Border Grid.Column="0"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="0,0,5,0">

                        <StackPanel>

                            <TextBlock Text="DaBoyzBot"
                                       Foreground="{StaticResource DaBoyzTextMuted}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="v1.1.0 ALPHA"
                                       Foreground="#F59E0B"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- KDG APP -->

                    <Border Grid.Column="1"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="5,0">

                        <StackPanel>

                            <TextBlock Text="DaBoyzApp"
                                       Foreground="{StaticResource DaBoyzTextMuted}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="v1.1.7 BETA"
                                       Foreground="#3B82F6"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- KDG TEXTURE -->

                    <Border Grid.Column="2"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="5,0">

                        <StackPanel>

                            <TextBlock Text="KDG Texture"
                                       Foreground="{StaticResource DaBoyzTextMuted}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="v1.0.0 RC"
                                       Foreground="#22C55E"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- KDG POSTAL -->

                    <Border Grid.Column="3"
                            Style="{StaticResource DashboardCardStyle}"
                            Margin="5,0,0,0">

                        <StackPanel>

                            <TextBlock Text="KDG Postal"
                                       Foreground="{StaticResource DaBoyzTextMuted}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="v1.0.0 RC"
                                       Foreground="#22C55E"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- ================================================= -->
                <!-- FOOTER                                            -->
                <!-- ================================================= -->

                <StackPanel HorizontalAlignment="Center"
                            Margin="0,35,0,0">

                    <TextBlock Text="DA BOYZ • KARO DEV GROUP"
                               Foreground="{StaticResource DaBoyzTextMuted}"
                               FontSize="11"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Created by: KaroDevGroup"
                               Foreground="#666666"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>