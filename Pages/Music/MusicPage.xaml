<Page x:Class="DaBoyzApp.Pages.MusicPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="45,40,45,30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <TextBlock Text="MUSIC DATABASE"
                           Foreground="{StaticResource DaBoyzText}"
                           FontSize="32"
                           FontWeight="Bold"/>

                <TextBlock Text="Original beats and instrumentals by Da Boyz."
                           Foreground="{StaticResource DaBoyzTextSecondary}"
                           FontSize="14"
                           Margin="0,5,0,0"/>

                <Border Height="2"
                        Width="80"
                        Background="{StaticResource DaBoyzRed}"
                        HorizontalAlignment="Left"
                        Margin="0,18,0,30"/>

            </StackPanel>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="2*"/>

                    <ColumnDefinition Width="28"/>

                    <ColumnDefinition Width="1*"/>

                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="BEAT LIBRARY"
                               Foreground="{StaticResource DaBoyzText}"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,14"/>

                    <Grid Grid.Row="1">

                        <ListBox x:Name="BeatList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="BeatList_SelectionChanged"
                                 MouseDoubleClick="BeatList_MouseDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListBox.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <WrapPanel Orientation="Horizontal"
                                               HorizontalAlignment="Left"/>

                                </ItemsPanelTemplate>

                            </ListBox.ItemsPanel>

                            <ListBox.ItemContainerStyle>

                                <Style TargetType="ListBoxItem">

                                    <Setter Property="Background"
                                            Value="Transparent"/>

                                    <Setter Property="BorderThickness"
                                            Value="0"/>

                                    <Setter Property="Padding"
                                            Value="0"/>

                                    <Setter Property="Margin"
                                            Value="0,0,14,14"/>

                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Stretch"/>

                                    <Setter Property="Template">

                                        <Setter.Value>

                                            <ControlTemplate TargetType="ListBoxItem">

                                                <Border x:Name="Card"
                                                        Width="240"
                                                        Height="125"
                                                        Background="{StaticResource DaBoyzPassiveCardBackgroundImage}"
                                                        BorderBrush="{StaticResource DaBoyzBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="18"
                                                        Cursor="Hand">

                                                    <StackPanel>

                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{StaticResource DaBoyzText}"
                                                                   FontSize="17"
                                                                   FontWeight="Bold"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <TextBlock Text="LOCAL MP3"
                                                                   Foreground="{StaticResource DaBoyzRed}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,5,0,0"/>

                                                        <Border Height="1"
                                                                Background="#303030"
                                                                Margin="0,14,0,12"/>

                                                        <TextBlock Text="Double-click to play"
                                                                   Foreground="{StaticResource DaBoyzTextMuted}"
                                                                   FontSize="10"/>

                                                    </StackPanel>

                                                </Border>

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">

                                                        <Setter TargetName="Card"
                                                                Property="BorderBrush"
                                                                Value="{StaticResource DaBoyzRed}"/>

                                                    </Trigger>

                                                    <Trigger Property="IsSelected"
                                                             Value="True">

                                                        <Setter TargetName="Card"
                                                                Property="BorderBrush"
                                                                Value="{StaticResource DaBoyzRedBright}"/>

                                                        <Setter TargetName="Card"
                                                                Property="Background"
                                                                Value="#401E0000"/>

                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>

                                        </Setter.Value>

                                    </Setter>

                                </Style>

                            </ListBox.ItemContainerStyle>

                        </ListBox>

                        <TextBlock x:Name="EmptyLibraryText"
                                   Text="No beats were found in Assets\Beats."
                                   Foreground="{StaticResource DaBoyzTextMuted}"
                                   FontSize="13"
                                   Visibility="Collapsed"
                                   Margin="0,10,0,20"
                                   VerticalAlignment="Top"
                                   IsHitTestVisible="False"/>

                    </Grid>

                </Grid>

                <Border Grid.Column="2"
                        BorderBrush="{StaticResource DaBoyzBorder}"
                        BorderThickness="1"
                        CornerRadius="14"
                        ClipToBounds="True">

                    <Grid>

                        <Border Background="#161616"
                                CornerRadius="14"/>

                        <Border CornerRadius="14"
                                Opacity="0.40">

                            <Border.Background>

                                <ImageBrush ImageSource="/Assets/MusicPlayerBackground.png"
                                            Stretch="UniformToFill"
                                            AlignmentX="Center"
                                            AlignmentY="Center"/>

                            </Border.Background>

                        </Border>

                        <Border Background="#50000000"
                                CornerRadius="14"/>

                        <Grid Margin="26">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">

                                <TextBlock Text="NOW PLAYING"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="DA BOYZ MUSIC PLAYER"
                                           Foreground="{StaticResource DaBoyzTextMuted}"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0"/>

                            </StackPanel>

                            <Grid Grid.Row="1"
                                  Margin="0,25,0,25">

                                <Border Background="#101010"
                                        BorderBrush="#292929"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        ClipToBounds="True">

                                    <Grid>

                                        <Image x:Name="ArtworkImage"
                                               Source="/Assets/DaBoyzLogo.png"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"/>

                                        <Border Background="#25000000"/>

                                        <Border VerticalAlignment="Bottom"
                                                Height="100">

                                            <Border.Background>

                                                <LinearGradientBrush StartPoint="0,0"
                                                                     EndPoint="0,1">

                                                    <GradientStop Color="#00000000"
                                                                  Offset="0"/>

                                                    <GradientStop Color="#B0000000"
                                                                  Offset="1"/>

                                                </LinearGradientBrush>

                                            </Border.Background>

                                        </Border>

                                    </Grid>

                                </Border>

                            </Grid>

                            <StackPanel Grid.Row="2">

                                <TextBlock x:Name="NowPlayingText"
                                           Text="Nothing selected"
                                           Foreground="{StaticResource DaBoyzText}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="LOCAL MP3"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                            <Grid Grid.Row="3"
                                  Margin="0,22,0,0">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Slider x:Name="ProgressSlider"
                                        Grid.Row="0"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="0"
                                        PreviewMouseLeftButtonUp="ProgressSlider_PreviewMouseLeftButtonUp"/>

                                <Grid Grid.Row="1"
                                      Margin="0,5,0,0">

                                    <TextBlock x:Name="CurrentTimeText"
                                               Text="0:00"
                                               Foreground="{StaticResource DaBoyzTextMuted}"
                                               FontSize="10"
                                               HorizontalAlignment="Left"/>

                                    <TextBlock x:Name="TotalTimeText"
                                               Text="0:00"
                                               Foreground="{StaticResource DaBoyzTextMuted}"
                                               FontSize="10"
                                               HorizontalAlignment="Right"/>

                                </Grid>

                            </Grid>

                            <Grid Grid.Row="4"
                                  Margin="0,18,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="VOLUME"
                                           Foreground="{StaticResource DaBoyzTextMuted}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>

                                <Slider x:Name="VolumeSlider"
                                        Grid.Column="1"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="70"
                                        VerticalAlignment="Center"
                                        ValueChanged="VolumeSlider_ValueChanged"/>

                                <TextBlock x:Name="VolumeText"
                                           Grid.Column="2"
                                           Text="70%"
                                           Foreground="{StaticResource DaBoyzTextSecondary}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>

                            </Grid>

                            <StackPanel Grid.Row="5"
                                        Margin="0,24,0,0">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="PreviousButton"
                                            Grid.Column="0"
                                            Content="◀"
                                            Height="42"
                                            Margin="0,0,8,0"
                                            Background="#161616"
                                            Foreground="White"
                                            BorderBrush="{StaticResource DaBoyzBorder}"
                                            BorderThickness="1"
                                            FontSize="14"
                                            Cursor="Hand"
                                            Click="PreviousButton_Click"/>

                                    <Button x:Name="PlayPauseButton"
                                            Grid.Column="1"
                                            Content="PLAY"
                                            Height="42"
                                            Margin="4,0"
                                            Background="{StaticResource DaBoyzRed}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Cursor="Hand"
                                            Click="PlayPauseButton_Click"/>

                                    <Button x:Name="NextButton"
                                            Grid.Column="2"
                                            Content="▶"
                                            Height="42"
                                            Margin="8,0,0,0"
                                            Background="#161616"
                                            Foreground="White"
                                            BorderBrush="{StaticResource DaBoyzBorder}"
                                            BorderThickness="1"
                                            FontSize="14"
                                            Cursor="Hand"
                                            Click="NextButton_Click"/>

                                </Grid>

                                <Button x:Name="StopButton"
                                        Content="STOP"
                                        Height="36"
                                        Margin="0,10,0,0"
                                        Background="#101010"
                                        Foreground="{StaticResource DaBoyzTextSecondary}"
                                        BorderBrush="{StaticResource DaBoyzBorder}"
                                        BorderThickness="1"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        Click="StopButton_Click"/>

                            </StackPanel>

                        </Grid>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,30">

            <TextBlock Text="DA BOYZ • MUSIC"
                       Foreground="{StaticResource DaBoyzTextMuted}"
                       FontSize="11"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Created by: KaroDevGroup"
                       Foreground="#666666"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>

        </StackPanel>

    </Grid>

</Page>