<Page x:Class="DaBoyzApp.Pages.PatchNotesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>

        <Style x:Key="DashboardButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#161616"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#292929"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="24">

                            <ContentPresenter/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Card"
                                        Property="Background"
                                        Value="#1E1E1E"/>

                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="#E00000"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Card"
                                        Property="Background"
                                        Value="#252525"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Page.Resources>

    <Grid Background="Transparent">

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="45,40,45,50">

                <TextBlock Text="PATCH NOTES"
                           Foreground="{StaticResource DaBoyzText}"
                           FontSize="32"
                           FontWeight="Bold"/>

                <TextBlock Text="Updates, improvements, fixes, and announcements."
                           Foreground="{StaticResource DaBoyzTextSecondary}"
                           FontSize="14"
                           Margin="0,5,0,0"/>

                <Border Height="2"
                        Width="80"
                        Background="{StaticResource DaBoyzRed}"
                        HorizontalAlignment="Left"
                        Margin="0,18,0,30"/>

                <Border x:Name="LatestVersionCard"
                        Style="{StaticResource DashboardCardStyle}"
                        Padding="28"
                        Margin="0,0,0,18">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <StackPanel Orientation="Horizontal">

                                <Border Background="{StaticResource DaBoyzRed}"
                                        CornerRadius="5"
                                        Padding="9,4">

                                    <TextBlock Text="LATEST"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <TextBlock Text="  v1.1.9"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                            <TextBlock Text="New Database, Rebranded UI, Music Page, and more!"
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="13"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="September 14th, 2026"
                                       Foreground="{StaticResource DaBoyzTextMuted}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="●"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="18"
                                   VerticalAlignment="Center"/>

                    </Grid>

                </Border>

                <Border x:Name="NewFeaturesCard"
                        Style="{StaticResource DashboardCardStyle}"
                        Padding="28"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="NEW FEATURES"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="What's New"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Margin="0,5,0,20"/>

                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="6"
                                    Background="#2A0000">

                                <TextBlock Text="+"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="New Database"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="New Database backend for the DaBoyzApp - Used for authentification and discord integration."
                                           Foreground="{StaticResource DaBoyzTextSecondary}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                        </Grid>

                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="6"
                                    Background="#2A0000">

                                <TextBlock Text="+"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="DaBoyzBot Integration"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="DaBoyzApp and DaBoyzBot now integrated together."
                                           Foreground="{StaticResource DaBoyzTextSecondary}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                        </Grid>

                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="6"
                                    Background="#2A0000">

                                <TextBlock Text="+"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Updated Decisions System"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Discord staff can now issue punishments through the app."
                                           Foreground="{StaticResource DaBoyzTextSecondary}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                        </Grid>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="6"
                                    Background="#2A0000">

                                <TextBlock Text="+"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="UI Rebrand"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="The entire DaBoyzApp UI has changed. New cards, new buttons, new designs."
                                           Foreground="{StaticResource DaBoyzTextSecondary}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>

                <Border x:Name="ImprovementsCard"
                        Style="{StaticResource DashboardCardStyle}"
                        Padding="28"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="IMPROVEMENTS"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Database &amp; Connectivity"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Margin="0,5,0,20"/>

                        <TextBlock Text="•  The new Database is ran with Python, can be slow at times."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="•  Staff members who are required to sign in must create an account with the Owner."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="•  Punishments made within the App may take a few seconds to register."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="•  Will be looked into again in the future, to hopefully speed up commands."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"/>

                    </StackPanel>

                </Border>

                <Border x:Name="FixesCard"
                        Style="{StaticResource DashboardCardStyle}"
                        Padding="28"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="FIXES"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Bug Fixes"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Margin="0,5,0,20"/>

                        <TextBlock Text="•  Fixed WebView2 pages failing to initialize correctly when DaBoyzApp was installed under Program Files."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="•  Fixed YouTube embedded videos failing to load correctly due to missing request headers."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="•  Improved update detection when GitHub releases are unavailable or have been removed."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="•  Fixed various installed-build WebView2 initialization and access issues."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"/>

                    </StackPanel>

                </Border>

                <TextBlock Text="DA BOYZ • PATCH NOTES"
                           Foreground="{StaticResource DaBoyzTextMuted}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0"/>

                <TextBlock Text="Created by: KaroDevGroup"
                           Foreground="#666666"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>