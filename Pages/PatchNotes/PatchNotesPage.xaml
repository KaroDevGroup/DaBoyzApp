<Page x:Class="DaBoyzApp.Pages.PatchNotesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="45,40,45,50">

                <!-- ================================================= -->
                <!-- HEADER                                            -->
                <!-- ================================================= -->

                <TextBlock Text="PATCH NOTES"
                           Foreground="{StaticResource DaBoyzText}"
                           FontSize="32"
                           FontWeight="Bold"/>

                <TextBlock Text="Updates, improvements, fixes, and announcements."
                           Foreground="{StaticResource DaBoyzTextSecondary}"
                           FontSize="14"
                           Margin="0,5,0,0"/>

                <Border Height="2"
                        Width="80"
                        Background="{StaticResource DaBoyzRed}"
                        HorizontalAlignment="Left"
                        Margin="0,18,0,30"/>


                <!-- ================================================= -->
                <!-- LATEST VERSION                                     -->
                <!-- ================================================= -->

                <Border Style="{StaticResource DaBoyzCardStyle}"
                        Padding="28"
                        Margin="0,0,0,18">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <StackPanel Orientation="Horizontal">

                                <Border Background="{StaticResource DaBoyzRed}"
                                        CornerRadius="5"
                                        Padding="9,4">

                                    <TextBlock Text="LATEST"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <TextBlock Text="  v1.1.5"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                            <TextBlock Text="Updater, WebView2, and Gaming improvements"
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="13"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="September 8th, 2026"
                                       Foreground="{StaticResource DaBoyzTextMuted}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="●"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="18"
                                   VerticalAlignment="Center"/>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- NEW FEATURES                                      -->
                <!-- ================================================= -->

                <Border Style="{StaticResource DaBoyzCardStyle}"
                        Padding="28"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="NEW FEATURES"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="What's New"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Margin="0,5,0,20"/>


                        <!-- AUTOMATIC UPDATES -->

                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="6"
                                    Background="#2A0000">

                                <TextBlock Text="+"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Automatic Updates"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Added automatic GitHub release detection so DaBoyzApp can notify users when a newer version is available."
                                           Foreground="{StaticResource DaBoyzTextSecondary}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                        </Grid>


                        <!-- DOWNLOAD PROGRESS -->

                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="6"
                                    Background="#2A0000">

                                <TextBlock Text="+"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Download Progress"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Added a live download progress bar that displays the real-time percentage while an update is being downloaded."
                                           Foreground="{StaticResource DaBoyzTextSecondary}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                        </Grid>


                        <!-- EMBEDDED WEB CONTENT -->

                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="6"
                                    Background="#2A0000">

                                <TextBlock Text="+"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Embedded Web Content"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Expanded the Gaming Database with integrated web pages for Destiny 2, Warzone, FiveM, Minecraft, Rainbow Six Siege, Rocket League, and Marvel Rivals."
                                           Foreground="{StaticResource DaBoyzTextSecondary}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                        </Grid>


                        <!-- DESTINY GUIDES -->

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="6"
                                    Background="#2A0000">

                                <TextBlock Text="+"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Destiny 2 Encounter Guides"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Added dedicated raid encounter pages with embedded video guides for multiple Destiny 2 raids and encounters."
                                           Foreground="{StaticResource DaBoyzTextSecondary}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- IMPROVEMENTS                                      -->
                <!-- ================================================= -->

                <Border Style="{StaticResource DaBoyzCardStyle}"
                        Padding="28"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="IMPROVEMENTS"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Performance &amp; Experience"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Margin="0,5,0,20"/>

                        <TextBlock Text="•  Improved WebView2 initialization for installed versions of DaBoyzApp."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="•  Added a shared WebView2 environment using a writable per-user application data directory."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="•  Improved the update experience with clearer download, completion, and installation states."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="•  Expanded the Gaming Database with additional game-specific resources and tools."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- FIXES                                             -->
                <!-- ================================================= -->

                <Border Style="{StaticResource DaBoyzCardStyle}"
                        Padding="28"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="FIXES"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Bug Fixes"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Margin="0,5,0,20"/>

                        <TextBlock Text="•  Fixed WebView2 pages failing to initialize correctly when DaBoyzApp was installed under Program Files."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="•  Fixed YouTube embedded videos failing to load correctly due to missing request headers."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="•  Improved update detection when GitHub releases are unavailable or have been removed."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="•  Fixed various installed-build WebView2 initialization and access issues."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- FOOTER                                            -->
                <!-- ================================================= -->

                <TextBlock Text="DA BOYZ • PATCH NOTES"
                           Foreground="{StaticResource DaBoyzTextMuted}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0"/>

                <TextBlock Text="Created by: KaroDevGroup"
                           Foreground="#666666"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>