<Page x:Class="DaBoyzApp.Pages.PatchNotesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="45,40,45,50">

                <!-- ================================================= -->
                <!-- HEADER                                            -->
                <!-- ================================================= -->

                <TextBlock Text="PATCH NOTES"
                           Foreground="{StaticResource DaBoyzText}"
                           FontSize="32"
                           FontWeight="Bold"/>

                <TextBlock Text="Updates, improvements, fixes, and announcements."
                           Foreground="{StaticResource DaBoyzTextSecondary}"
                           FontSize="14"
                           Margin="0,5,0,0"/>

                <Border Height="2"
                        Width="80"
                        Background="{StaticResource DaBoyzRed}"
                        HorizontalAlignment="Left"
                        Margin="0,18,0,30"/>


                <!-- ================================================= -->
                <!-- LATEST VERSION                                     -->
                <!-- ================================================= -->

                <Border Style="{StaticResource DaBoyzCardStyle}"
                        Padding="28"
                        Margin="0,0,0,18">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <StackPanel Orientation="Horizontal">

                                <Border Background="{StaticResource DaBoyzRed}"
                                        CornerRadius="5"
                                        Padding="9,4">

                                    <TextBlock Text="LATEST"
                                               Foreground="White"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                </Border>

                                <TextBlock Text="  v0.1.0"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                            <TextBlock Text="Initial Release"
                                       Foreground="{StaticResource DaBoyzTextSecondary}"
                                       FontSize="13"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="August 27, 2026"
                                       Foreground="{StaticResource DaBoyzTextMuted}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="●"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="18"
                                   VerticalAlignment="Center"/>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- NEW FEATURES                                      -->
                <!-- ================================================= -->

                <Border Style="{StaticResource DaBoyzCardStyle}"
                        Padding="28"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="NEW FEATURES"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="What's New"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Margin="0,5,0,20"/>


                        <!-- GAMING DATABASE -->

                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="6"
                                    Background="#2A0000">

                                <TextBlock Text="+"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Gaming Database"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Added the foundation for the Da Boyz Gaming Database, including game cards, search, and category filtering."
                                           Foreground="{StaticResource DaBoyzTextSecondary}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                        </Grid>


                        <!-- ADMIN PORTAL -->

                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="6"
                                    Background="#2A0000">

                                <TextBlock Text="+"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Admin Portal"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Added the administrator login interface and authentication screen."
                                           Foreground="{StaticResource DaBoyzTextSecondary}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                        </Grid>


                        <!-- ANIMATED BACKGROUND -->

                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="6"
                                    Background="#2A0000">

                                <TextBlock Text="+"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Animated Background"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Added the animated particle background system used throughout the application."
                                           Foreground="{StaticResource DaBoyzTextSecondary}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                        </Grid>


                        <!-- DASHBOARD NAVIGATION -->

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="6"
                                    Background="#2A0000">

                                <TextBlock Text="+"
                                           Foreground="{StaticResource DaBoyzRed}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Dashboard Navigation"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Added dashboard cards and improved navigation between application sections."
                                           Foreground="{StaticResource DaBoyzTextSecondary}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- IMPROVEMENTS                                      -->
                <!-- ================================================= -->

                <Border Style="{StaticResource DaBoyzCardStyle}"
                        Padding="28"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="IMPROVEMENTS"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="UI &amp; Experience"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Margin="0,5,0,20"/>

                        <TextBlock Text="•  Refined the Da Boyz red, black, and white visual theme."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="•  Added elevated cards and shadows to improve depth."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="•  Improved sidebar selection states."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="•  Added consistent application-wide color resources."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- FIXES                                             -->
                <!-- ================================================= -->

                <Border Style="{StaticResource DaBoyzCardStyle}"
                        Padding="28"
                        Margin="0,0,0,18">

                    <StackPanel>

                        <TextBlock Text="FIXES"
                                   Foreground="{StaticResource DaBoyzRed}"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Bug Fixes"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Margin="0,5,0,20"/>

                        <TextBlock Text="•  Fixed sidebar highlighting when navigating from dashboard cards."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="•  Fixed search placeholder behavior on the Gaming Database."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="•  Improved text caret visibility in the Admin Portal."
                                   Foreground="{StaticResource DaBoyzTextSecondary}"
                                   FontSize="12"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- FOOTER                                            -->
                <!-- ================================================= -->

                <TextBlock Text="DA BOYZ • PATCH NOTES"
                           Foreground="{StaticResource DaBoyzTextMuted}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0"/>

                <TextBlock Text="Created by: KaroDevGroup"
                           Foreground="#666666"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>