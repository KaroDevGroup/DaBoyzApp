<Window x:Class="DaBoyzApp.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Da Boyz - Update Available"
        Width="520"
        Height="390"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="#111111"
            BorderBrush="#292929"
            BorderThickness="1"
            CornerRadius="12"
            Margin="8">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER                                            -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                        Margin="30,28,30,0">

                <TextBlock Text="DA BOYZ"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#FF1A1A"/>

                <TextBlock Text="UPDATE AVAILABLE"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,4,0,0"/>

                <Border Width="65"
                        Height="2"
                        HorizontalAlignment="Left"
                        Background="#E00000"
                        Margin="0,14,0,0"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- CONTENT                                           -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="1"
                        Margin="30,25,30,15">

                <TextBlock Text="A new version of DaBoyzApp is available."
                           FontSize="15"
                           Foreground="#B0B0B0"/>


                <!-- VERSION COMPARISON -->

                <Grid Margin="0,25,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- CURRENT -->

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="CURRENT VERSION"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#666666"/>

                        <TextBlock x:Name="CurrentVersionText"
                                   Text="1.0.0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,4,0,0"/>

                    </StackPanel>


                    <!-- ARROW -->

                    <TextBlock Grid.Column="1"
                               Text="→"
                               FontSize="22"
                               Foreground="#666666"
                               VerticalAlignment="Center"
                               Margin="20,12,20,0"/>


                    <!-- LATEST -->

                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Right">

                        <TextBlock Text="LATEST VERSION"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#666666"
                                   HorizontalAlignment="Right"/>

                        <TextBlock x:Name="LatestVersionText"
                                   Text="1.1.0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Right"/>

                    </StackPanel>

                </Grid>


                <!-- DESCRIPTION -->

                <TextBlock x:Name="ReleaseDescriptionText"
                           Text="The latest version contains improvements and updates."
                           FontSize="12"
                           Foreground="#666666"
                           TextWrapping="Wrap"
                           Margin="0,25,0,0"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- BUTTONS                                           -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="30,0,30,25">

                <Button x:Name="LaterButton"
                        Content="LATER"
                        Width="110"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="#161616"
                        Foreground="#B0B0B0"
                        BorderBrush="#292929"
                        BorderThickness="1"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="LaterButton_Click"/>

                <Button x:Name="UpdateButton"
                        Content="UPDATE NOW"
                        Width="130"
                        Height="40"
                        Background="#E00000"
                        Foreground="White"
                        BorderBrush="#E00000"
                        BorderThickness="1"
                        FontSize="11"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="UpdateButton_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>