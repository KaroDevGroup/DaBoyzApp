<Window x:Class="DaBoyzApp.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Da Boyz - Update Available"
        Width="520"
        Height="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Grid>

        <Border Background="#080808"
                BorderBrush="#292929"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True"
                Margin="8">

            <Grid>

                <Border Background="#080808"/>

                <Image Source="/Assets/UpdateBackground.png"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Opacity="0.40"/>

                <Border Background="#70000000"/>

                <Ellipse Width="430"
                         Height="430"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Opacity="0.10">

                    <Ellipse.Fill>

                        <RadialGradientBrush>

                            <GradientStop Color="#E00000"
                                          Offset="0"/>

                            <GradientStop Color="#900000"
                                          Offset="0.35"/>

                            <GradientStop Color="#00000000"
                                          Offset="1"/>

                        </RadialGradientBrush>

                    </Ellipse.Fill>

                </Ellipse>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="30,28,30,0">

                        <TextBlock Text="DA BOYZ"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#FF1A1A"/>

                        <TextBlock Text="UPDATE AVAILABLE"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,4,0,0"/>

                        <Border Width="65"
                                Height="2"
                                HorizontalAlignment="Left"
                                Background="#E00000"
                                Margin="0,14,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="30,25,30,15">

                        <TextBlock Text="A new version of DaBoyzApp is available."
                                   FontSize="15"
                                   Foreground="#D0D0D0"/>

                        <Grid Margin="0,25,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="CURRENT VERSION"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#888888"/>

                                <TextBlock x:Name="CurrentVersionText"
                                           Text="1.1.5"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,4,0,0"/>

                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="→"
                                       FontSize="22"
                                       Foreground="#888888"
                                       VerticalAlignment="Center"
                                       Margin="20,12,20,0"/>

                            <StackPanel Grid.Column="2"
                                        HorizontalAlignment="Right">

                                <TextBlock Text="LATEST VERSION"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#888888"
                                           HorizontalAlignment="Right"/>

                                <TextBlock x:Name="LatestVersionText"
                                           Text="1.1.0"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#FF1A1A"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Right"/>

                            </StackPanel>

                        </Grid>

                        <Border Background="#B0141414"
                                BorderBrush="#40292929"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,22,0,0">

                            <TextBlock x:Name="ReleaseDescriptionText"
                                       Text="The latest version contains improvements and updates."
                                       FontSize="12"
                                       Foreground="#A0A0A0"
                                       TextWrapping="Wrap"/>

                        </Border>

                        <StackPanel x:Name="DownloadProgressPanel"
                                    Visibility="Collapsed"
                                    Margin="0,20,0,0">

                            <Grid>

                                <TextBlock x:Name="DownloadStatusText"
                                           Text="DOWNLOADING UPDATE..."
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#D0D0D0"
                                           HorizontalAlignment="Left"/>

                                <TextBlock x:Name="DownloadPercentageText"
                                           Text="0%"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#FF1A1A"
                                           HorizontalAlignment="Right"/>

                            </Grid>

                            <Border Height="4"
                                    Background="#80161616"
                                    CornerRadius="2"
                                    Margin="0,10,0,0">

                                <Border x:Name="DownloadProgressBar"
                                        Width="0"
                                        Height="4"
                                        HorizontalAlignment="Left"
                                        Background="#E00000"
                                        CornerRadius="2"/>

                            </Border>

                        </StackPanel>

                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="30,0,30,25">

                        <Button x:Name="LaterButton"
                                Content="LATER"
                                Width="110"
                                Height="40"
                                Margin="0,0,10,0"
                                Background="#D0161616"
                                Foreground="#D0D0D0"
                                BorderBrush="#404040"
                                BorderThickness="1"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="LaterButton_Click"/>

                        <Button x:Name="UpdateButton"
                                Content="UPDATE NOW"
                                Width="130"
                                Height="40"
                                Background="#E00000"
                                Foreground="White"
                                BorderBrush="#E00000"
                                BorderThickness="1"
                                FontSize="11"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="UpdateButton_Click"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>